diff --git a/src/gateway/openai_codex.zig b/src/gateway/openai_codex.zig
new file mode 100644
index 0000000..3717014
--- /dev/null
+++ b/src/gateway/openai_codex.zig
@@ -0,0 +1,589 @@
+const std = @import("std");
+const agent_stream_provider = @import("../core/agent/stream_provider.zig");
+const io_mod = @import("../core/shared/io.zig");
+const types = @import("../core/shared/types.zig");
+const gateway_client = @import("client.zig");
+
+const Allocator = std.mem.Allocator;
+
+pub const model_prefix = "openai-codex/";
+pub const responses_url = "https://chatgpt.com/backend-api/codex/responses";
+const max_error_body_bytes: usize = 64 * 1024;
+const max_sse_line_bytes: usize = 1024 * 1024;
+
+pub fn isModel(model: []const u8) bool {
+    return std.mem.startsWith(u8, model, model_prefix) and model.len > model_prefix.len;
+}
+
+pub fn buildRequest(
+    alloc: Allocator,
+    request: agent_stream_provider.BuildRequest,
+) ![]u8 {
+    if (!isModel(request.model)) return error.InvalidOpenAICodexModel;
+    if (request.verified_images != null or request.vision_mode != .unavailable) {
+        return error.OpenAICodexImagesUnsupported;
+    }
+    if (request.response_format != null) return error.OpenAICodexStructuredResponseUnsupported;
+
+    var instructions: std.ArrayList(u8) = .empty;
+    defer instructions.deinit(alloc);
+    for (request.messages) |message| {
+        if (message.role != .system) continue;
+        const content = message.content orelse continue;
+        if (instructions.items.len > 0) try instructions.appendSlice(alloc, "\n\n");
+        try instructions.appendSlice(alloc, content);
+    }
+
+    var out: std.Io.Writer.Allocating = .init(alloc);
+    errdefer out.deinit();
+    const writer = &out.writer;
+    try writer.writeAll("{\"model\":");
+    try std.json.Stringify.value(request.model[model_prefix.len..], .{}, writer);
+    try writer.writeAll(",\"store\":false,\"stream\":true,\"instructions\":");
+    try std.json.Stringify.value(
+        if (instructions.items.len > 0) instructions.items else "You are a helpful assistant.",
+        .{},
+        writer,
+    );
+    try writer.writeAll(",\"input\":[");
+
+    var first_input = true;
+    for (request.messages) |message| {
+        switch (message.role) {
+            .system => continue,
+            .user => try writeMessageItem(writer, &first_input, "user", "input_text", message.content orelse ""),
+            .assistant => {
+                if (message.content) |content| {
+                    if (content.len > 0) {
+                        try writeMessageItem(writer, &first_input, "assistant", "output_text", content);
+                    }
+                }
+                for (message.tool_calls) |call| {
+                    try writeSeparator(writer, &first_input);
+                    try writer.writeAll("{\"type\":\"function_call\",\"call_id\":");
+                    try std.json.Stringify.value(call.id, .{}, writer);
+                    try writer.writeAll(",\"name\":");
+                    try std.json.Stringify.value(call.name, .{}, writer);
+                    try writer.writeAll(",\"arguments\":");
+                    try std.json.Stringify.value(call.arguments_json, .{}, writer);
+                    try writer.writeByte('}');
+                }
+            },
+            .tool => {
+                const call_id = message.tool_call_id orelse return error.OpenAICodexToolCallIdMissing;
+                try writeSeparator(writer, &first_input);
+                try writer.writeAll("{\"type\":\"function_call_output\",\"call_id\":");
+                try std.json.Stringify.value(call_id, .{}, writer);
+                try writer.writeAll(",\"output\":");
+                try std.json.Stringify.value(message.content orelse "", .{}, writer);
+                try writer.writeByte('}');
+            },
+        }
+    }
+    try writer.writeAll("],\"tools\":[");
+    var first_tool = true;
+    try writeSerializedToolArray(alloc, writer, &first_tool, request.serialized_tools);
+    for (request.selected_dynamic_tool_schemas) |schema| {
+        var parsed = try std.json.parseFromSlice(std.json.Value, alloc, schema, .{});
+        defer parsed.deinit();
+        try writeToolSchema(writer, &first_tool, parsed.value);
+    }
+    try writer.writeAll("],\"tool_choice\":");
+    try std.json.Stringify.value(request.tool_choice.label(), .{}, writer);
+    try writer.writeAll(",\"parallel_tool_calls\":true,\"text\":{\"verbosity\":\"low\"},\"include\":[\"reasoning.encrypted_content\"]");
+    if (request.session_id) |session_id| {
+        if (cacheKey(session_id).len > 0) {
+            try writer.writeAll(",\"prompt_cache_key\":");
+            try std.json.Stringify.value(cacheKey(session_id), .{}, writer);
+        }
+    }
+    if (request.provider_options.reasoning) |resolved_effort| {
+        var effort = resolved_effort;
+        try writer.writeAll(",\"reasoning\":{\"effort\":");
+        try std.json.Stringify.value(effort.label(), .{}, writer);
+        try writer.writeAll(",\"summary\":\"auto\"}");
+    }
+    try writer.writeByte('}');
+    return out.toOwnedSlice();
+}
+
+fn writeMessageItem(
+    writer: *std.Io.Writer,
+    first: *bool,
+    role: []const u8,
+    content_type: []const u8,
+    text: []const u8,
+) !void {
+    try writeSeparator(writer, first);
+    try writer.writeAll("{\"type\":\"message\",\"role\":");
+    try std.json.Stringify.value(role, .{}, writer);
+    if (std.mem.eql(u8, role, "assistant")) try writer.writeAll(",\"status\":\"completed\"");
+    try writer.writeAll(",\"content\":[{\"type\":");
+    try std.json.Stringify.value(content_type, .{}, writer);
+    try writer.writeAll(",\"text\":");
+    try std.json.Stringify.value(text, .{}, writer);
+    if (std.mem.eql(u8, content_type, "output_text")) try writer.writeAll(",\"annotations\":[]");
+    try writer.writeAll("}]}");
+}
+
+fn writeSeparator(writer: *std.Io.Writer, first: *bool) !void {
+    if (!first.*) try writer.writeByte(',');
+    first.* = false;
+}
+
+fn writeSerializedToolArray(
+    alloc: Allocator,
+    writer: *std.Io.Writer,
+    first: *bool,
+    serialized_tools: []const u8,
+) !void {
+    var parsed = try std.json.parseFromSlice(std.json.Value, alloc, serialized_tools, .{});
+    defer parsed.deinit();
+    if (parsed.value != .array) return error.InvalidOpenAICodexTools;
+    for (parsed.value.array.items) |tool| try writeToolSchema(writer, first, tool);
+}
+
+fn writeToolSchema(writer: *std.Io.Writer, first: *bool, tool: std.json.Value) !void {
+    if (tool != .object) return error.InvalidOpenAICodexTool;
+    const name = tool.object.get("name") orelse return error.InvalidOpenAICodexTool;
+    const description = tool.object.get("description") orelse return error.InvalidOpenAICodexTool;
+    const parameters = tool.object.get("inputSchema") orelse
+        tool.object.get("parameters") orelse return error.InvalidOpenAICodexTool;
+    if (name != .string or description != .string or parameters != .object) {
+        return error.InvalidOpenAICodexTool;
+    }
+    try writeSeparator(writer, first);
+    try writer.writeAll("{\"type\":\"function\",\"name\":");
+    try std.json.Stringify.value(name.string, .{}, writer);
+    try writer.writeAll(",\"description\":");
+    try std.json.Stringify.value(description.string, .{}, writer);
+    try writer.writeAll(",\"parameters\":");
+    try std.json.Stringify.value(parameters, .{}, writer);
+    try writer.writeAll(",\"strict\":false}");
+}
+
+pub fn stream(
+    alloc: Allocator,
+    request: agent_stream_provider.Request,
+) !agent_stream_provider.Result {
+    if (!isModel(request.model)) return error.InvalidOpenAICodexModel;
+    const account_id = request.team orelse return error.OpenAICodexAccountIdMissing;
+    if (account_id.len == 0) return error.OpenAICodexAccountIdMissing;
+    if (request.cancel_flag.load(.seq_cst)) return error.Cancelled;
+
+    const uri = try std.Uri.parse(responses_url);
+    const auth_header = try std.fmt.allocPrint(alloc, "Bearer {s}", .{request.api_key});
+    defer alloc.free(auth_header);
+
+    var extra_headers_buf: [7]std.http.Header = undefined;
+    var extra_len: usize = 0;
+    extra_headers_buf[extra_len] = .{ .name = "chatgpt-account-id", .value = account_id };
+    extra_len += 1;
+    extra_headers_buf[extra_len] = .{ .name = "originator", .value = "fx" };
+    extra_len += 1;
+    extra_headers_buf[extra_len] = .{ .name = "OpenAI-Beta", .value = "responses=experimental" };
+    extra_len += 1;
+    extra_headers_buf[extra_len] = .{ .name = "accept", .value = "text/event-stream" };
+    extra_len += 1;
+    if (request.session_id) |session_id| {
+        const cache_key = cacheKey(session_id);
+        if (cache_key.len > 0) {
+            extra_headers_buf[extra_len] = .{ .name = "session-id", .value = cache_key };
+            extra_len += 1;
+            extra_headers_buf[extra_len] = .{ .name = "x-client-request-id", .value = cache_key };
+            extra_len += 1;
+        }
+    }
+
+    var client: std.http.Client = .{ .allocator = alloc, .io = io_mod.getIo() };
+    defer client.deinit();
+    var http_request = try client.request(.POST, uri, .{
+        .headers = .{
+            .content_type = .{ .override = "application/json" },
+            .authorization = .{ .override = auth_header },
+            .accept_encoding = .omit,
+            .user_agent = .{ .override = gateway_client.user_agent },
+        },
+        .extra_headers = extra_headers_buf[0..extra_len],
+        .keep_alive = false,
+        .redirect_behavior = .unhandled,
+    });
+    defer http_request.deinit();
+
+    http_request.transfer_encoding = .{ .content_length = request.payload.len };
+    var send_buffer: [8192]u8 = undefined;
+    request.delivery.markPossiblySent();
+    var body_writer = try http_request.sendBodyUnflushed(&send_buffer);
+    try body_writer.writer.writeAll(request.payload);
+    try body_writer.end();
+    try http_request.connection.?.flush();
+    if (request.cancel_flag.load(.seq_cst)) return error.Cancelled;
+
+    var response = try http_request.receiveHead(&.{});
+    if (response.head.status != .ok) {
+        var error_buffer: [max_error_body_bytes]u8 = undefined;
+        var error_writer = std.Io.Writer.fixed(&error_buffer);
+        var transfer_buffer: [4096]u8 = undefined;
+        const error_reader = response.reader(&transfer_buffer);
+        _ = error_reader.streamRemaining(&error_writer) catch {};
+        return .{
+            .status = response.head.status,
+            .err_body = try alloc.dupe(u8, error_writer.buffered()),
+            .ownership = .owned,
+        };
+    }
+
+    request.attempt_evidence.provider_admitted = true;
+    var transfer_buffer: [8192]u8 = undefined;
+    const reader = response.reader(&transfer_buffer);
+    const completion = try consumeSseStream(alloc, reader, request);
+    return .{
+        .status = .ok,
+        .completion = completion,
+        .reconcile_generation_usage = false,
+        .ownership = .owned,
+    };
+}
+
+fn cacheKey(session_id: []const u8) []const u8 {
+    return session_id[0..@min(session_id.len, 64)];
+}
+
+const SseReader = struct {
+    pending: std.ArrayList(u8) = .empty,
+
+    fn deinit(self: *SseReader, alloc: Allocator) void {
+        self.pending.deinit(alloc);
+    }
+
+    fn release(self: *SseReader) void {
+        self.pending.clearRetainingCapacity();
+    }
+
+    fn next(self: *SseReader, alloc: Allocator, reader: *std.Io.Reader) !?[]const u8 {
+        while (true) {
+            const fragment = reader.takeDelimiter('\n') catch |err| switch (err) {
+                error.StreamTooLong => {
+                    const buffered = reader.buffered();
+                    if (buffered.len == 0) return error.OpenAICodexSseReadStalled;
+                    if (buffered.len > max_sse_line_bytes - self.pending.items.len) {
+                        return error.OpenAICodexSseEventTooLarge;
+                    }
+                    try self.pending.appendSlice(alloc, buffered);
+                    reader.tossBuffered();
+                    continue;
+                },
+                error.ReadFailed => return error.ReadFailed,
+            } orelse {
+                if (self.pending.items.len > 0) return self.pending.items;
+                return null;
+            };
+            if (fragment.len > max_sse_line_bytes - self.pending.items.len) {
+                return error.OpenAICodexSseEventTooLarge;
+            }
+            if (self.pending.items.len == 0) return fragment;
+            try self.pending.appendSlice(alloc, fragment);
+            return self.pending.items;
+        }
+    }
+};
+
+fn consumeSseStream(
+    alloc: Allocator,
+    reader: *std.Io.Reader,
+    request: agent_stream_provider.Request,
+) !types.GatewayCompletion {
+    var content: std.ArrayList(u8) = .empty;
+    defer content.deinit(alloc);
+    var tool_calls: std.ArrayList(types.ToolCall) = .empty;
+    defer tool_calls.deinit(alloc);
+    errdefer for (tool_calls.items) |call| types.freeToolCall(alloc, call);
+    var started_tool_ids: std.ArrayList([]u8) = .empty;
+    defer {
+        for (started_tool_ids.items) |id| alloc.free(id);
+        started_tool_ids.deinit(alloc);
+    }
+    var provider_failure_detail: ?[]u8 = null;
+    errdefer if (provider_failure_detail) |detail| alloc.free(detail);
+    var usage: types.Usage = .{};
+    var finish_reason: ?types.ProviderFinishReason = null;
+    var terminal = false;
+    var sse_reader: SseReader = .{};
+    defer sse_reader.deinit(alloc);
+
+    while (!terminal) {
+        if (request.cancel_flag.load(.seq_cst)) return error.Cancelled;
+        const raw_line = (try sse_reader.next(alloc, reader)) orelse break;
+        defer sse_reader.release();
+        const line = std.mem.trim(u8, raw_line, "\r");
+        if (line.len == 0 or line[0] == ':') continue;
+        const prefix = "data:";
+        if (!std.mem.startsWith(u8, line, prefix)) continue;
+        const data = std.mem.trimStart(u8, line[prefix.len..], " ");
+        if (std.mem.eql(u8, data, "[DONE]")) break;
+
+        var parsed = std.json.parseFromSlice(std.json.Value, alloc, data, .{}) catch |err| {
+            if (err == error.OutOfMemory) return err;
+            continue;
+        };
+        defer parsed.deinit();
+        if (parsed.value != .object) continue;
+        const root = parsed.value.object;
+        const event_type_value = root.get("type") orelse continue;
+        if (event_type_value != .string) continue;
+        const event_type = event_type_value.string;
+
+        if (std.mem.eql(u8, event_type, "response.output_text.delta")) {
+            const delta = stringField(root, "delta") orelse continue;
+            request.on_content_chunk(request.callback_ctx, delta);
+            try appendCaptured(alloc, &content, delta, request.content_capture_limit);
+            continue;
+        }
+        if (std.mem.eql(u8, event_type, "response.reasoning_summary_text.delta")) {
+            const delta = stringField(root, "delta") orelse continue;
+            if (request.on_reasoning_chunk) |callback| callback(request.callback_ctx, delta);
+            continue;
+        }
+        if (std.mem.eql(u8, event_type, "response.function_call_arguments.delta")) {
+            const delta = stringField(root, "delta") orelse continue;
+            if (request.on_tool_input_chunk) |callback| callback(request.callback_ctx, delta);
+            continue;
+        }
+        if (std.mem.eql(u8, event_type, "response.output_item.added")) {
+            const item = objectField(root, "item") orelse continue;
+            if (!stringFieldEquals(item, "type", "function_call")) continue;
+            const id = stringField(item, "call_id") orelse continue;
+            const name = stringField(item, "name") orelse continue;
+            try markToolStarted(alloc, &started_tool_ids, request, id, name);
+            continue;
+        }
+        if (std.mem.eql(u8, event_type, "response.output_item.done")) {
+            const item = objectField(root, "item") orelse continue;
+            if (!stringFieldEquals(item, "type", "function_call")) continue;
+            const id = stringField(item, "call_id") orelse continue;
+            const name = stringField(item, "name") orelse continue;
+            const arguments = stringField(item, "arguments") orelse "{}";
+            try markToolStarted(alloc, &started_tool_ids, request, id, name);
+            if (findToolCall(tool_calls.items, id) != null) continue;
+            const owned_id = try alloc.dupe(u8, id);
+            errdefer alloc.free(owned_id);
+            const owned_name = try alloc.dupe(u8, name);
+            errdefer alloc.free(owned_name);
+            const owned_arguments = try alloc.dupe(u8, arguments);
+            errdefer alloc.free(owned_arguments);
+            try tool_calls.append(alloc, .{
+                .id = owned_id,
+                .name = owned_name,
+                .arguments_json = owned_arguments,
+                .argument_integrity = try types.ToolArgumentIntegrity.classifySerialized(alloc, arguments),
+            });
+            continue;
+        }
+        if (std.mem.eql(u8, event_type, "response.completed") or
+            std.mem.eql(u8, event_type, "response.done") or
+            std.mem.eql(u8, event_type, "response.incomplete"))
+        {
+            const response = objectField(root, "response") orelse root;
+            if (objectField(response, "usage")) |usage_value| usage = parseUsage(usage_value);
+            const status = stringField(response, "status") orelse "completed";
+            finish_reason = if (std.mem.eql(u8, event_type, "response.incomplete") or
+                std.mem.eql(u8, status, "incomplete"))
+                .length
+            else if (tool_calls.items.len > 0)
+                .tool_calls
+            else
+                .stop;
+            terminal = true;
+            continue;
+        }
+        if (std.mem.eql(u8, event_type, "response.failed") or std.mem.eql(u8, event_type, "error")) {
+            const detail = responseErrorMessage(root) orelse "OpenAI Codex response failed";
+            provider_failure_detail = try alloc.dupe(u8, detail);
+            finish_reason = .provider_error;
+            terminal = true;
+        }
+    }
+
+    if (!terminal) return error.OpenAICodexStreamEndedEarly;
+    const owned_content: ?[]u8 = if (content.items.len > 0) try content.toOwnedSlice(alloc) else null;
+    errdefer if (owned_content) |value| alloc.free(value);
+    const owned_tools = try tool_calls.toOwnedSlice(alloc);
+    return .{
+        .content = owned_content,
+        .tool_calls = owned_tools,
+        .provider_failure_detail = provider_failure_detail,
+        .finish_reason = finish_reason,
+        .usage = usage,
+    };
+}
+
+fn appendCaptured(
+    alloc: Allocator,
+    content: *std.ArrayList(u8),
+    delta: []const u8,
+    limit: ?usize,
+) !void {
+    const remaining = if (limit) |maximum| maximum -| @min(maximum, content.items.len) else delta.len;
+    try content.appendSlice(alloc, delta[0..@min(delta.len, remaining)]);
+}
+
+fn markToolStarted(
+    alloc: Allocator,
+    ids: *std.ArrayList([]u8),
+    request: agent_stream_provider.Request,
+    id: []const u8,
+    name: []const u8,
+) !void {
+    for (ids.items) |existing| if (std.mem.eql(u8, existing, id)) return;
+    const owned_id = try alloc.dupe(u8, id);
+    errdefer alloc.free(owned_id);
+    try ids.append(alloc, owned_id);
+    if (request.on_tool_start) |callback| callback(request.callback_ctx, id, name, null);
+}
+
+fn findToolCall(tool_calls: []const types.ToolCall, id: []const u8) ?usize {
+    for (tool_calls, 0..) |tool_call, index| {
+        if (std.mem.eql(u8, tool_call.id, id)) return index;
+    }
+    return null;
+}
+
+fn objectField(object: std.json.ObjectMap, key: []const u8) ?std.json.ObjectMap {
+    const value = object.get(key) orelse return null;
+    return if (value == .object) value.object else null;
+}
+
+fn stringField(object: std.json.ObjectMap, key: []const u8) ?[]const u8 {
+    const value = object.get(key) orelse return null;
+    return if (value == .string) value.string else null;
+}
+
+fn stringFieldEquals(object: std.json.ObjectMap, key: []const u8, expected: []const u8) bool {
+    const value = stringField(object, key) orelse return false;
+    return std.mem.eql(u8, value, expected);
+}
+
+fn parseUsage(object: std.json.ObjectMap) types.Usage {
+    return .{
+        .input_tokens = nonNegativeInteger(object.get("input_tokens")),
+        .output_tokens = nonNegativeInteger(object.get("output_tokens")),
+    };
+}
+
+fn nonNegativeInteger(value: ?std.json.Value) ?u64 {
+    const actual = value orelse return null;
+    if (actual != .integer or actual.integer < 0) return null;
+    return @intCast(actual.integer);
+}
+
+fn responseErrorMessage(root: std.json.ObjectMap) ?[]const u8 {
+    if (stringField(root, "message")) |message| return message;
+    const error_value = root.get("error");
+    if (error_value) |value| {
+        if (value == .string) return value.string;
+        if (value == .object) if (stringField(value.object, "message")) |message| return message;
+    }
+    const response = objectField(root, "response") orelse return null;
+    const nested_error = objectField(response, "error") orelse return null;
+    return stringField(nested_error, "message");
+}
+
+test "OpenAI Codex request maps messages and tool schemas" {
+    const tools = "[{\"type\":\"function\",\"name\":\"read_file\",\"description\":\"Read\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}]";
+    const calls = [_]types.ToolCall{.{
+        .id = "call_1",
+        .name = "read_file",
+        .arguments_json = "{\"path\":\"README.md\"}",
+    }};
+    const messages = [_]types.ChatMessage{
+        .{ .role = .system, .content = "Be concise." },
+        .{ .role = .user, .content = "Read it" },
+        .{ .role = .assistant, .tool_calls = &calls },
+        .{ .role = .tool, .tool_call_id = "call_1", .content = "contents" },
+    };
+    const body = try buildRequest(std.testing.allocator, .{
+        .credential_source = .openai_codex,
+        .session_id = "session-123",
+        .model = "openai-codex/gpt-5.6-sol",
+        .serialized_tools = tools,
+        .messages = &messages,
+        .tool_choice = .auto,
+        .provider_options = .{},
+    });
+    defer std.testing.allocator.free(body);
+    try std.testing.expect(std.mem.find(u8, body, "\"model\":\"gpt-5.6-sol\"") != null);
+    try std.testing.expect(std.mem.find(u8, body, "\"parameters\":") != null);
+    try std.testing.expect(std.mem.find(u8, body, "\"inputSchema\":") == null);
+    try std.testing.expect(std.mem.find(u8, body, "\"type\":\"function_call_output\"") != null);
+    try std.testing.expect(std.mem.find(u8, body, "\"prompt_cache_key\":\"session-123\"") != null);
+}
+
+test "OpenAI Codex SSE maps text tools and usage" {
+    const Capture = struct {
+        content_bytes: usize = 0,
+        tool_starts: usize = 0,
+        tool_argument_bytes: usize = 0,
+
+        fn content(raw: *anyopaque, chunk: []const u8) void {
+            const self: *@This() = @ptrCast(@alignCast(raw));
+            self.content_bytes += chunk.len;
+        }
+
+        fn toolStart(
+            raw: *anyopaque,
+            _: []const u8,
+            _: []const u8,
+            _: ?[]const u8,
+        ) void {
+            const self: *@This() = @ptrCast(@alignCast(raw));
+            self.tool_starts += 1;
+        }
+
+        fn toolArguments(raw: *anyopaque, chunk: []const u8) void {
+            const self: *@This() = @ptrCast(@alignCast(raw));
+            self.tool_argument_bytes += chunk.len;
+        }
+    };
+    const payload =
+        "data: {\"type\":\"response.output_text.delta\",\"delta\":\"Hello\"}\n\n" ++
+        "data: {\"type\":\"response.output_item.added\",\"item\":{\"type\":\"function_call\",\"call_id\":\"call_1\",\"name\":\"read_file\"}}\n\n" ++
+        "data: {\"type\":\"response.function_call_arguments.delta\",\"delta\":\"{}\"}\n\n" ++
+        "data: {\"type\":\"response.output_item.done\",\"item\":{\"type\":\"function_call\",\"call_id\":\"call_1\",\"name\":\"read_file\",\"arguments\":\"{}\"}}\n\n" ++
+        "data: {\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"usage\":{\"input_tokens\":5,\"output_tokens\":3}}}\n\n";
+    var reader = std.Io.Reader.fixed(payload);
+    var cancel = std.atomic.Value(bool).init(false);
+    var delivery = agent_stream_provider.DeliveryCertainty.init();
+    var evidence: agent_stream_provider.AttemptEvidence = .{};
+    var capture: Capture = .{};
+    const completion = try consumeSseStream(std.testing.allocator, &reader, .{
+        .api_key = "token",
+        .team = "account",
+        .model = "openai-codex/gpt-5.6-sol",
+        .retry_count = 1,
+        .chat_url = "",
+        .payload = "{}",
+        .trace_ctx = .{},
+        .content_capture_limit = null,
+        .delivery = &delivery,
+        .attempt_evidence = &evidence,
+        .callback_ctx = &capture,
+        .on_content_chunk = Capture.content,
+        .on_tool_start = Capture.toolStart,
+        .on_reasoning_chunk = null,
+        .on_tool_input_chunk = Capture.toolArguments,
+        .cancel_flag = &cancel,
+        .credential_source = .openai_codex,
+    });
+    defer {
+        if (completion.content) |content| std.testing.allocator.free(@constCast(content));
+        types.freeToolCallSlice(std.testing.allocator, @constCast(completion.tool_calls));
+    }
+    try std.testing.expectEqualStrings("Hello", completion.content.?);
+    try std.testing.expectEqual(@as(usize, 1), completion.tool_calls.len);
+    try std.testing.expectEqualStrings("read_file", completion.tool_calls[0].name);
+    try std.testing.expectEqual(@as(?u64, 5), completion.usage.input_tokens);
+    try std.testing.expectEqual(types.ProviderFinishReason.tool_calls, completion.finish_reason.?);
+    try std.testing.expectEqual(@as(usize, 5), capture.content_bytes);
+    try std.testing.expectEqual(@as(usize, 1), capture.tool_starts);
+    try std.testing.expectEqual(@as(usize, 2), capture.tool_argument_bytes);
+}
