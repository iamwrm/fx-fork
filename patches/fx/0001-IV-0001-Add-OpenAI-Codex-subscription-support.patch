diff --git a/src/core/auth/openai_codex.zig b/src/core/auth/openai_codex.zig
new file mode 100644
index 0000000..3bae2bf
--- /dev/null
+++ b/src/core/auth/openai_codex.zig
@@ -0,0 +1,655 @@
+const std = @import("std");
+const debug_trace = @import("../shared/debug_trace.zig");
+const host = @import("../hosts/host.zig");
+const host_target = @import("../hosts/target.zig");
+const io_mod = @import("../shared/io.zig");
+const oauth_transport = @import("oauth_transport.zig");
+const profile_paths = @import("../shared/profile_paths.zig");
+const secret = @import("secret.zig");
+
+const Allocator = std.mem.Allocator;
+
+pub const client_id = "app_EMoamEEZ73f0CkXaXp7hrann";
+pub const default_model = "openai-codex/gpt-5.6-sol";
+pub const verification_uri = "https://auth.openai.com/codex/device";
+const user_code_url = "https://auth.openai.com/api/accounts/deviceauth/usercode";
+const device_token_url = "https://auth.openai.com/api/accounts/deviceauth/token";
+const token_url = "https://auth.openai.com/oauth/token";
+const redirect_uri = "https://auth.openai.com/deviceauth/callback";
+const auth_file_name = "openai-codex-auth.json";
+const lock_file_name = "openai-codex-auth.lock";
+const max_auth_file_bytes: usize = 64 * 1024;
+const mutation_lock_deadline_ms: u64 = 2000;
+const device_timeout_ms: i64 = 15 * 60 * std.time.ms_per_s;
+const expiry_skew_ms: i64 = 5 * 60 * std.time.ms_per_s;
+
+pub const AuthError = error{
+    InvalidResponse,
+    AuthorizationDenied,
+    AuthorizationExpired,
+    AuthorizationPending,
+    SlowDown,
+    RequestFailed,
+    AccountIdMissing,
+};
+
+pub const Access = struct {
+    token: []u8,
+    account_id: []u8,
+    refresh_after_ms: i64,
+
+    pub fn deinit(self: *Access, alloc: Allocator) void {
+        secret.zeroAndFree(alloc, self.token);
+        if (self.account_id.len > 0) alloc.free(self.account_id);
+        self.* = undefined;
+    }
+};
+
+const Session = struct {
+    access_token: []u8,
+    refresh_token: []u8,
+    expires_at_ms: i64,
+
+    fn deinit(self: *Session, alloc: Allocator) void {
+        secret.zeroAndFree(alloc, self.access_token);
+        secret.zeroAndFree(alloc, self.refresh_token);
+        self.* = undefined;
+    }
+
+    fn expired(self: Session, now_ms: i64) bool {
+        return refreshDeadlineMs(self.expires_at_ms) <= now_ms;
+    }
+};
+
+const Mutation = struct {
+    fx_dir: io_mod.VerifiedDir,
+    lock: io_mod.TimedAdvisoryLock,
+
+    fn deinit(self: *Mutation) void {
+        self.lock.release();
+        self.fx_dir.close();
+        self.* = undefined;
+    }
+
+    fn load(self: *Mutation, alloc: Allocator) !?Session {
+        return loadFromDir(alloc, &self.fx_dir.dir, true);
+    }
+
+    fn save(self: *Mutation, alloc: Allocator, session: Session) !void {
+        const text = try stringify(alloc, session);
+        defer secret.zeroAndFree(alloc, text);
+        try io_mod.durableReplaceVerified(alloc, &self.fx_dir, auth_file_name, text);
+    }
+
+    fn delete(self: *Mutation) !bool {
+        self.fx_dir.dir.deleteFile(io_mod.getIo(), auth_file_name) catch |err| switch (err) {
+            error.FileNotFound => return false,
+            else => return err,
+        };
+        io_mod.syncVerifiedDir(self.fx_dir.dir) catch |err| switch (err) {
+            error.OperationUnsupported => {},
+            else => return err,
+        };
+        return true;
+    }
+};
+
+const DeviceAuthorization = struct {
+    device_auth_id: []u8,
+    user_code: []u8,
+    interval_seconds: u64,
+
+    fn deinit(self: *DeviceAuthorization, alloc: Allocator) void {
+        secret.zeroAndFree(alloc, self.device_auth_id);
+        alloc.free(self.user_code);
+        self.* = undefined;
+    }
+};
+
+const DeviceGrant = struct {
+    authorization_code: []u8,
+    code_verifier: []u8,
+
+    fn deinit(self: *DeviceGrant, alloc: Allocator) void {
+        secret.zeroAndFree(alloc, self.authorization_code);
+        secret.zeroAndFree(alloc, self.code_verifier);
+        self.* = undefined;
+    }
+};
+
+const TokenSet = struct {
+    access_token: []u8,
+    refresh_token: []u8,
+    expires_in: i64,
+
+    fn deinit(self: *TokenSet, alloc: Allocator) void {
+        secret.zeroAndFree(alloc, self.access_token);
+        secret.zeroAndFree(alloc, self.refresh_token);
+        self.* = undefined;
+    }
+};
+
+const PollResult = union(enum) {
+    pending,
+    slow_down,
+    complete: DeviceGrant,
+};
+
+const RemoteError = enum {
+    pending,
+    slow_down,
+    denied,
+    expired,
+    unknown,
+};
+
+pub fn runLogin(
+    alloc: Allocator,
+    transport: oauth_transport.Provider,
+    url_opener: host.UrlOpener,
+) !void {
+    if (comptime host_target.is_wasm) return error.OpenAICodexUnavailable;
+
+    var device = try requestDeviceAuthorization(alloc, transport);
+    defer device.deinit(alloc);
+
+    try writeStdout("Open ");
+    try writeStdout(verification_uri);
+    try writeStdout("\nCode: ");
+    try writeStdout(device.user_code);
+    try writeStdout("\n\nWaiting for OpenAI authorization...\n");
+    _ = url_opener.open(alloc, verification_uri) catch false;
+
+    const started_ms = io_mod.milliTimestamp();
+    var interval_seconds = @max(device.interval_seconds, 1);
+    var grant: DeviceGrant = while (true) {
+        if (io_mod.milliTimestamp() - started_ms >= device_timeout_ms) {
+            return AuthError.AuthorizationExpired;
+        }
+        io_mod.sleep(interval_seconds *| std.time.ns_per_s);
+        switch (try pollDeviceAuthorization(alloc, transport, device)) {
+            .pending => {},
+            .slow_down => interval_seconds = @min(interval_seconds +| 5, 30),
+            .complete => |value| break value,
+        }
+    };
+    defer grant.deinit(alloc);
+
+    var token = try exchangeAuthorizationCode(alloc, transport, grant);
+    defer token.deinit(alloc);
+    const account_id = try accountIdFromAccessToken(alloc, token.access_token);
+    defer alloc.free(account_id);
+
+    var session = Session{
+        .access_token = token.access_token,
+        .refresh_token = token.refresh_token,
+        .expires_at_ms = try expiryTimestampMs(io_mod.milliTimestamp(), token.expires_in),
+    };
+    token.access_token = &.{};
+    token.refresh_token = &.{};
+    defer session.deinit(alloc);
+    try saveNewSession(alloc, session);
+    try writeStdout("Signed in to OpenAI Codex.\n");
+}
+
+pub fn loadAccess(
+    alloc: Allocator,
+    transport: oauth_transport.Provider,
+) !?Access {
+    var session = (try load(alloc)) orelse return null;
+    defer session.deinit(alloc);
+    if (session.expired(io_mod.milliTimestamp())) {
+        return refreshAccessLocked(alloc, transport, false);
+    }
+    return @as(?Access, try takeAccess(alloc, &session));
+}
+
+pub fn loadStoredAccess(alloc: Allocator) !?Access {
+    var session = (try load(alloc)) orelse return null;
+    defer session.deinit(alloc);
+    return @as(?Access, try takeAccess(alloc, &session));
+}
+
+pub fn refreshAccess(
+    alloc: Allocator,
+    transport: oauth_transport.Provider,
+) !?Access {
+    return refreshAccessLocked(alloc, transport, true);
+}
+
+pub fn exists(alloc: Allocator) !bool {
+    var session = (try load(alloc)) orelse return false;
+    defer session.deinit(alloc);
+    return true;
+}
+
+pub fn logout() !bool {
+    if (comptime host_target.is_wasm) return false;
+    var mutation = (try beginExistingMutation()) orelse return false;
+    defer mutation.deinit();
+    return mutation.delete();
+}
+
+fn refreshAccessLocked(
+    alloc: Allocator,
+    transport: oauth_transport.Provider,
+    force: bool,
+) !?Access {
+    var mutation = (try beginExistingMutation()) orelse return null;
+    defer mutation.deinit();
+    var session = (try mutation.load(alloc)) orelse return null;
+    defer session.deinit(alloc);
+
+    if (force or session.expired(io_mod.milliTimestamp())) {
+        var token = try refreshToken(alloc, transport, session.refresh_token);
+        defer token.deinit(alloc);
+        secret.zeroAndFree(alloc, session.access_token);
+        session.access_token = token.access_token;
+        token.access_token = &.{};
+        secret.zeroAndFree(alloc, session.refresh_token);
+        session.refresh_token = token.refresh_token;
+        token.refresh_token = &.{};
+        session.expires_at_ms = try expiryTimestampMs(io_mod.milliTimestamp(), token.expires_in);
+        try mutation.save(alloc, session);
+    }
+    return @as(?Access, try takeAccess(alloc, &session));
+}
+
+fn takeAccess(alloc: Allocator, session: *Session) !Access {
+    const account_id = try accountIdFromAccessToken(alloc, session.access_token);
+    errdefer alloc.free(account_id);
+    const token = session.access_token;
+    session.access_token = &.{};
+    return .{
+        .token = token,
+        .account_id = account_id,
+        .refresh_after_ms = refreshDeadlineMs(session.expires_at_ms),
+    };
+}
+
+fn refreshDeadlineMs(expires_at_ms: i64) i64 {
+    return expires_at_ms -| expiry_skew_ms;
+}
+
+fn expiryTimestampMs(now_ms: i64, expires_in_seconds: i64) AuthError!i64 {
+    if (expires_in_seconds <= 0) return AuthError.InvalidResponse;
+    const duration_ms = std.math.mul(i64, expires_in_seconds, std.time.ms_per_s) catch
+        return AuthError.InvalidResponse;
+    return std.math.add(i64, now_ms, duration_ms) catch AuthError.InvalidResponse;
+}
+
+fn requestDeviceAuthorization(
+    alloc: Allocator,
+    transport: oauth_transport.Provider,
+) !DeviceAuthorization {
+    const payload = "{\"client_id\":\"" ++ client_id ++ "\"}";
+    var response = try transport.execute(alloc, .{
+        .method = .post_json,
+        .url = user_code_url,
+        .payload = payload,
+    });
+    defer response.deinit(alloc);
+    if (response.disposition != .accepted) return AuthError.RequestFailed;
+    return parseDeviceAuthorization(alloc, response.body);
+}
+
+fn pollDeviceAuthorization(
+    alloc: Allocator,
+    transport: oauth_transport.Provider,
+    device: DeviceAuthorization,
+) !PollResult {
+    var payload_writer: std.Io.Writer.Allocating = .init(alloc);
+    defer payload_writer.deinit();
+    try payload_writer.writer.writeAll("{\"device_auth_id\":");
+    try std.json.Stringify.value(device.device_auth_id, .{}, &payload_writer.writer);
+    try payload_writer.writer.writeAll(",\"user_code\":");
+    try std.json.Stringify.value(device.user_code, .{}, &payload_writer.writer);
+    try payload_writer.writer.writeByte('}');
+
+    var response = try transport.execute(alloc, .{
+        .method = .post_json,
+        .url = device_token_url,
+        .payload = payload_writer.written(),
+    });
+    defer response.deinit(alloc);
+    if (response.disposition == .accepted) {
+        return .{ .complete = try parseDeviceGrant(alloc, response.body) };
+    }
+    if (response.status == .forbidden or response.status == .not_found) return .pending;
+    switch (parseRemoteError(alloc, response.body) catch .unknown) {
+        .pending => return .pending,
+        .slow_down => return .slow_down,
+        .denied => return AuthError.AuthorizationDenied,
+        .expired => return AuthError.AuthorizationExpired,
+        .unknown => {},
+    }
+    return AuthError.RequestFailed;
+}
+
+fn exchangeAuthorizationCode(
+    alloc: Allocator,
+    transport: oauth_transport.Provider,
+    grant: DeviceGrant,
+) !TokenSet {
+    var form: std.Io.Writer.Allocating = .init(alloc);
+    defer form.deinit();
+    var first = true;
+    try appendForm(&form.writer, &first, "grant_type", "authorization_code");
+    try appendForm(&form.writer, &first, "client_id", client_id);
+    try appendForm(&form.writer, &first, "code", grant.authorization_code);
+    try appendForm(&form.writer, &first, "code_verifier", grant.code_verifier);
+    try appendForm(&form.writer, &first, "redirect_uri", redirect_uri);
+    return requestToken(alloc, transport, form.written());
+}
+
+fn refreshToken(
+    alloc: Allocator,
+    transport: oauth_transport.Provider,
+    refresh_token: []const u8,
+) !TokenSet {
+    var form: std.Io.Writer.Allocating = .init(alloc);
+    defer form.deinit();
+    var first = true;
+    try appendForm(&form.writer, &first, "grant_type", "refresh_token");
+    try appendForm(&form.writer, &first, "refresh_token", refresh_token);
+    try appendForm(&form.writer, &first, "client_id", client_id);
+    return requestToken(alloc, transport, form.written());
+}
+
+fn requestToken(
+    alloc: Allocator,
+    transport: oauth_transport.Provider,
+    payload: []const u8,
+) !TokenSet {
+    var response = try transport.execute(alloc, .{
+        .method = .post_form,
+        .url = token_url,
+        .payload = payload,
+    });
+    defer response.deinit(alloc);
+    if (response.disposition != .accepted) return AuthError.RequestFailed;
+    return parseTokenSet(alloc, response.body);
+}
+
+fn parseDeviceAuthorization(alloc: Allocator, bytes: []const u8) !DeviceAuthorization {
+    var parsed = try std.json.parseFromSlice(std.json.Value, alloc, bytes, .{});
+    defer parsed.deinit();
+    if (parsed.value != .object) return AuthError.InvalidResponse;
+    const object = parsed.value.object;
+    const device_auth_id = try dupeRequiredString(alloc, object, "device_auth_id");
+    errdefer secret.zeroAndFree(alloc, device_auth_id);
+    const user_code = try dupeRequiredString(alloc, object, "user_code");
+    errdefer alloc.free(user_code);
+    const interval = object.get("interval") orelse return AuthError.InvalidResponse;
+    const interval_seconds: u64 = switch (interval) {
+        .integer => |value| if (value >= 0) @intCast(value) else return AuthError.InvalidResponse,
+        .string => |value| std.fmt.parseUnsigned(u64, std.mem.trim(u8, value, " \t\r\n"), 10) catch
+            return AuthError.InvalidResponse,
+        else => return AuthError.InvalidResponse,
+    };
+    return .{
+        .device_auth_id = device_auth_id,
+        .user_code = user_code,
+        .interval_seconds = interval_seconds,
+    };
+}
+
+fn parseDeviceGrant(alloc: Allocator, bytes: []const u8) !DeviceGrant {
+    var parsed = try std.json.parseFromSlice(std.json.Value, alloc, bytes, .{});
+    defer parsed.deinit();
+    if (parsed.value != .object) return AuthError.InvalidResponse;
+    const authorization_code = try dupeRequiredString(alloc, parsed.value.object, "authorization_code");
+    errdefer secret.zeroAndFree(alloc, authorization_code);
+    return .{
+        .authorization_code = authorization_code,
+        .code_verifier = try dupeRequiredString(alloc, parsed.value.object, "code_verifier"),
+    };
+}
+
+fn parseTokenSet(alloc: Allocator, bytes: []const u8) !TokenSet {
+    var parsed = try std.json.parseFromSlice(std.json.Value, alloc, bytes, .{});
+    defer parsed.deinit();
+    if (parsed.value != .object) return AuthError.InvalidResponse;
+    const object = parsed.value.object;
+    const access_token = try dupeRequiredString(alloc, object, "access_token");
+    errdefer secret.zeroAndFree(alloc, access_token);
+    const refresh_token = try dupeRequiredString(alloc, object, "refresh_token");
+    errdefer secret.zeroAndFree(alloc, refresh_token);
+    const expires = object.get("expires_in") orelse return AuthError.InvalidResponse;
+    if (expires != .integer or expires.integer <= 0) return AuthError.InvalidResponse;
+    return .{
+        .access_token = access_token,
+        .refresh_token = refresh_token,
+        .expires_in = expires.integer,
+    };
+}
+
+fn parseRemoteError(alloc: Allocator, bytes: []const u8) !RemoteError {
+    var parsed = try std.json.parseFromSlice(std.json.Value, alloc, bytes, .{});
+    defer parsed.deinit();
+    if (parsed.value != .object) return .unknown;
+    const error_value = parsed.value.object.get("error") orelse return .unknown;
+    const code: ?[]const u8 = switch (error_value) {
+        .string => |value| value,
+        .object => |object| blk: {
+            const code = object.get("code") orelse break :blk null;
+            break :blk if (code == .string) code.string else null;
+        },
+        else => null,
+    };
+    const value = code orelse return .unknown;
+    if (std.mem.eql(u8, value, "deviceauth_authorization_pending")) return .pending;
+    if (std.mem.eql(u8, value, "slow_down")) return .slow_down;
+    if (std.mem.eql(u8, value, "access_denied")) return .denied;
+    if (std.mem.eql(u8, value, "expired_token")) return .expired;
+    return .unknown;
+}
+
+fn dupeRequiredString(alloc: Allocator, object: std.json.ObjectMap, key: []const u8) ![]u8 {
+    const value = object.get(key) orelse return AuthError.InvalidResponse;
+    if (value != .string or value.string.len == 0) return AuthError.InvalidResponse;
+    return alloc.dupe(u8, value.string);
+}
+
+fn appendForm(
+    writer: *std.Io.Writer,
+    first: *bool,
+    key: []const u8,
+    value: []const u8,
+) !void {
+    if (!first.*) try writer.writeByte('&');
+    first.* = false;
+    try percentEncode(writer, key);
+    try writer.writeByte('=');
+    try percentEncode(writer, value);
+}
+
+fn percentEncode(writer: *std.Io.Writer, value: []const u8) !void {
+    const hex = "0123456789ABCDEF";
+    for (value) |byte| {
+        if (std.ascii.isAlphanumeric(byte) or byte == '-' or byte == '_' or byte == '.' or byte == '~') {
+            try writer.writeByte(byte);
+        } else {
+            try writer.writeByte('%');
+            try writer.writeByte(hex[byte >> 4]);
+            try writer.writeByte(hex[byte & 0x0f]);
+        }
+    }
+}
+
+pub fn accountIdFromAccessToken(alloc: Allocator, token: []const u8) ![]u8 {
+    var parts = std.mem.splitScalar(u8, token, '.');
+    _ = parts.next() orelse return AuthError.AccountIdMissing;
+    const encoded = parts.next() orelse return AuthError.AccountIdMissing;
+    _ = parts.next() orelse return AuthError.AccountIdMissing;
+    if (parts.next() != null) return AuthError.AccountIdMissing;
+
+    const decoded_len = std.base64.url_safe_no_pad.Decoder.calcSizeForSlice(encoded) catch
+        return AuthError.AccountIdMissing;
+    const decoded = try alloc.alloc(u8, decoded_len);
+    defer alloc.free(decoded);
+    std.base64.url_safe_no_pad.Decoder.decode(decoded, encoded) catch
+        return AuthError.AccountIdMissing;
+    var parsed = std.json.parseFromSlice(std.json.Value, alloc, decoded, .{}) catch
+        return AuthError.AccountIdMissing;
+    defer parsed.deinit();
+    if (parsed.value != .object) return AuthError.AccountIdMissing;
+    const auth = parsed.value.object.get("https://api.openai.com/auth") orelse
+        return AuthError.AccountIdMissing;
+    if (auth != .object) return AuthError.AccountIdMissing;
+    const account_id = auth.object.get("chatgpt_account_id") orelse
+        return AuthError.AccountIdMissing;
+    if (account_id != .string or account_id.string.len == 0) return AuthError.AccountIdMissing;
+    return alloc.dupe(u8, account_id.string);
+}
+
+fn load(alloc: Allocator) !?Session {
+    if (comptime host_target.is_wasm) return null;
+    const home = io_mod.getenv("HOME") orelse return null;
+    var home_dir = std.Io.Dir.openDirAbsolute(io_mod.getIo(), home, .{ .iterate = true }) catch return null;
+    defer home_dir.close(io_mod.getIo());
+    var fx_dir = home_dir.openDir(io_mod.getIo(), profile_paths.root_dir_name, .{
+        .iterate = true,
+        .follow_symlinks = false,
+    }) catch return null;
+    defer fx_dir.close(io_mod.getIo());
+    return loadFromDir(alloc, &fx_dir, false);
+}
+
+fn loadFromDir(alloc: Allocator, fx_dir: *std.Io.Dir, report_errors: bool) !?Session {
+    var file = fx_dir.openFile(io_mod.getIo(), auth_file_name, .{
+        .mode = .read_only,
+        .allow_directory = false,
+        .follow_symlinks = false,
+        .resolve_beneath = true,
+    }) catch |err| switch (err) {
+        error.FileNotFound => return null,
+        else => if (report_errors) return err else return null,
+    };
+    defer file.close(io_mod.getIo());
+    const stat = try file.stat(io_mod.getIo());
+    if (stat.kind != .file or stat.permissions.toMode() & 0o077 != 0) {
+        if (report_errors) return error.InsecureAuthFile;
+        return null;
+    }
+    const bytes = try io_mod.readFileToEnd(alloc, &file, max_auth_file_bytes);
+    defer secret.zeroAndFree(alloc, bytes);
+    return parseSession(alloc, bytes) catch |err| {
+        if (err == error.OutOfMemory or report_errors) return err;
+        debug_trace.logf("auth", "OpenAI Codex session parse failed err={s}", .{@errorName(err)});
+        return null;
+    };
+}
+
+fn saveNewSession(alloc: Allocator, session: Session) !void {
+    var mutation = try beginMutation();
+    defer mutation.deinit();
+    try mutation.save(alloc, session);
+}
+
+fn beginMutation() !Mutation {
+    const home = io_mod.getenv("HOME") orelse return error.HomeNotSet;
+    var home_dir = io_mod.VerifiedDir{
+        .dir = try std.Io.Dir.openDirAbsolute(io_mod.getIo(), home, .{ .iterate = true }),
+    };
+    defer home_dir.close();
+    var fx_dir = try io_mod.openOrCreateVerifiedPrivateDir(&home_dir, profile_paths.root_dir_name);
+    errdefer fx_dir.close();
+    const lock = try io_mod.acquireTimedAdvisoryLock(&fx_dir, lock_file_name, mutation_lock_deadline_ms);
+    return .{ .fx_dir = fx_dir, .lock = lock };
+}
+
+fn beginExistingMutation() !?Mutation {
+    if (comptime host_target.is_wasm) return null;
+    const home = io_mod.getenv("HOME") orelse return null;
+    var home_dir = io_mod.VerifiedDir{
+        .dir = try std.Io.Dir.openDirAbsolute(io_mod.getIo(), home, .{ .iterate = true }),
+    };
+    defer home_dir.close();
+    var fx_dir = home_dir.dir.openDir(io_mod.getIo(), profile_paths.root_dir_name, .{
+        .iterate = true,
+        .follow_symlinks = false,
+    }) catch |err| switch (err) {
+        error.FileNotFound => return null,
+        else => return err,
+    };
+    errdefer fx_dir.close(io_mod.getIo());
+    const stat = try fx_dir.stat(io_mod.getIo());
+    if (stat.kind != .directory) return error.DurablePathUnsafe;
+    try fx_dir.setPermissions(io_mod.getIo(), std.Io.File.Permissions.fromMode(0o700));
+    var verified = io_mod.VerifiedDir{ .dir = fx_dir };
+    errdefer verified.close();
+    const lock = try io_mod.acquireTimedAdvisoryLock(&verified, lock_file_name, mutation_lock_deadline_ms);
+    return .{ .fx_dir = verified, .lock = lock };
+}
+
+fn parseSession(alloc: Allocator, bytes: []const u8) !Session {
+    var parsed = try std.json.parseFromSlice(std.json.Value, alloc, bytes, .{});
+    defer parsed.deinit();
+    if (parsed.value != .object) return AuthError.InvalidResponse;
+    const object = parsed.value.object;
+    const version = object.get("version") orelse return AuthError.InvalidResponse;
+    if (version != .integer or version.integer != 1) return AuthError.InvalidResponse;
+    const access_token = try dupeRequiredString(alloc, object, "access_token");
+    errdefer secret.zeroAndFree(alloc, access_token);
+    const refresh_token = try dupeRequiredString(alloc, object, "refresh_token");
+    errdefer secret.zeroAndFree(alloc, refresh_token);
+    const expires = object.get("expires_at_ms") orelse return AuthError.InvalidResponse;
+    if (expires != .integer) return AuthError.InvalidResponse;
+    return .{
+        .access_token = access_token,
+        .refresh_token = refresh_token,
+        .expires_at_ms = expires.integer,
+    };
+}
+
+fn stringify(alloc: Allocator, session: Session) ![]u8 {
+    var out: std.Io.Writer.Allocating = .init(alloc);
+    errdefer out.deinit();
+    try out.writer.writeAll("{\"version\":1,\"access_token\":");
+    try std.json.Stringify.value(session.access_token, .{}, &out.writer);
+    try out.writer.writeAll(",\"refresh_token\":");
+    try std.json.Stringify.value(session.refresh_token, .{}, &out.writer);
+    try out.writer.print(",\"expires_at_ms\":{d}}}\n", .{session.expires_at_ms});
+    return out.toOwnedSlice();
+}
+
+fn writeStdout(text: []const u8) !void {
+    try std.Io.File.stdout().writeStreamingAll(io_mod.getIo(), text);
+}
+
+test "OpenAI Codex device response accepts string intervals" {
+    var device = try parseDeviceAuthorization(
+        std.testing.allocator,
+        "{\"device_auth_id\":\"device\",\"user_code\":\"ABCD-EFGH\",\"interval\":\"7\"}",
+    );
+    defer device.deinit(std.testing.allocator);
+    try std.testing.expectEqual(@as(u64, 7), device.interval_seconds);
+}
+
+test "OpenAI Codex account id is extracted from the access token" {
+    const payload = "{\"https://api.openai.com/auth\":{\"chatgpt_account_id\":\"acct_test\"}}";
+    var encoded_buf: [256]u8 = undefined;
+    const encoded = std.base64.url_safe_no_pad.Encoder.encode(&encoded_buf, payload);
+    const token = try std.fmt.allocPrint(std.testing.allocator, "header.{s}.signature", .{encoded});
+    defer std.testing.allocator.free(token);
+    const account_id = try accountIdFromAccessToken(std.testing.allocator, token);
+    defer std.testing.allocator.free(account_id);
+    try std.testing.expectEqualStrings("acct_test", account_id);
+}
+
+test "OpenAI Codex sessions round trip" {
+    var session = Session{
+        .access_token = try std.testing.allocator.dupe(u8, "access"),
+        .refresh_token = try std.testing.allocator.dupe(u8, "refresh"),
+        .expires_at_ms = 1234,
+    };
+    defer session.deinit(std.testing.allocator);
+    const text = try stringify(std.testing.allocator, session);
+    defer secret.zeroAndFree(std.testing.allocator, text);
+    var parsed = try parseSession(std.testing.allocator, text);
+    defer parsed.deinit(std.testing.allocator);
+    try std.testing.expectEqualStrings("access", parsed.access_token);
+    try std.testing.expectEqualStrings("refresh", parsed.refresh_token);
+    try std.testing.expectEqual(@as(i64, 1234), parsed.expires_at_ms);
+}
