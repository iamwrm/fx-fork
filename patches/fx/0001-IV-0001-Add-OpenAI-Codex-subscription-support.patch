+pub fn loadOpenAICodexCredential(
+    alloc: std.mem.Allocator,
+    transport: oauth_transport.Provider,
+) !?Credential {
+    var access = (try openai_codex.loadAccess(alloc, transport)) orelse return null;
+    defer access.deinit(alloc);
+    return takeOpenAICodexCredential(&access);
+}
+
+fn loadStoredOpenAICodexCredential(alloc: std.mem.Allocator) !?Credential {
+    var access = (try openai_codex.loadStoredAccess(alloc)) orelse return null;
+    defer access.deinit(alloc);
+    return takeOpenAICodexCredential(&access);
+}
+
+pub fn refreshOpenAICodexCredential(
+    alloc: std.mem.Allocator,
+    transport: oauth_transport.Provider,
+) !?Credential {
+    var access = (try openai_codex.refreshAccess(alloc, transport)) orelse return null;
+    defer access.deinit(alloc);
+    return takeOpenAICodexCredential(&access);
+}
+
+fn takeOpenAICodexCredential(access: *openai_codex.Access) Credential {
+    const token = access.token;
+    access.token = &.{};
+    const account_id = access.account_id;
+    access.account_id = &.{};
+    return .{
+        .token = token,
+        .source = .openai_codex,
+        .team_id = account_id,
+        .refresh_after_ms = access.refresh_after_ms,
+    };
+}
+
