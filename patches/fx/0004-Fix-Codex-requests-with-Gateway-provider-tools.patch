From 8d07edb3b7680e7126738a6dd3f4e2a835c43727 Mon Sep 17 00:00:00 2001
From: Ren Wang <iamwrm@gmail.com>
Date: Thu, 20 Aug 2026 21:00:01 +0800
Subject: [PATCH] Fix Codex requests with Gateway provider tools

---
 src/gateway/openai_codex.zig | 36 +++++++++++++++++++++++++++++++++++-
 1 file changed, 35 insertions(+), 1 deletion(-)

diff --git a/src/gateway/openai_codex.zig b/src/gateway/openai_codex.zig
index 583e746..2c311c0 100644
--- a/src/gateway/openai_codex.zig
+++ b/src/gateway/openai_codex.zig
@@ -146,7 +146,19 @@ fn writeSerializedToolArray(
     var parsed = try std.json.parseFromSlice(std.json.Value, alloc, serialized_tools, .{});
     defer parsed.deinit();
     if (parsed.value != .array) return error.InvalidOpenAICodexTools;
-    for (parsed.value.array.items) |tool| try writeToolSchema(writer, first, tool);
+    for (parsed.value.array.items) |tool| {
+        // AI Gateway provider advertisements (currently web_search) cannot be
+        // forwarded to the direct ChatGPT Codex endpoint. They are not local
+        // function schemas and the subscription transport cannot execute them.
+        if (isGatewayProviderAdvertisement(tool)) continue;
+        try writeToolSchema(writer, first, tool);
+    }
+}
+
+fn isGatewayProviderAdvertisement(tool: std.json.Value) bool {
+    if (tool != .object) return false;
+    const tool_type = tool.object.get("type") orelse return false;
+    return tool_type == .string and std.mem.eql(u8, tool_type.string, "provider");
 }
 
 fn writeToolSchema(writer: *std.Io.Writer, first: *bool, tool: std.json.Value) !void {
@@ -525,6 +537,28 @@ test "OpenAI Codex request maps messages and tool schemas" {
     try std.testing.expect(std.mem.find(u8, body, "\"prompt_cache_key\":\"session-123\"") != null);
 }
 
+test "OpenAI Codex request omits AI Gateway provider tool advertisements" {
+    const tools =
+        "[{\"type\":\"function\",\"name\":\"read_file\",\"description\":\"Read\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}," ++
+        "{\"type\":\"provider\",\"id\":\"gateway.perplexity_search\",\"name\":\"perplexity_search\",\"args\":{}}]";
+    const messages = [_]types.ChatMessage{
+        .{ .role = .user, .content = "Hello" },
+    };
+    const body = try buildRequest(std.testing.allocator, .{
+        .credential_source = .openai_codex,
+        .model = "openai-codex/gpt-5.6-sol",
+        .serialized_tools = tools,
+        .messages = &messages,
+        .tool_choice = .auto,
+        .provider_options = .{},
+    });
+    defer std.testing.allocator.free(body);
+
+    try std.testing.expect(std.mem.find(u8, body, "\"name\":\"read_file\"") != null);
+    try std.testing.expect(std.mem.find(u8, body, "gateway.perplexity_search") == null);
+    try std.testing.expect(std.mem.find(u8, body, "\"name\":\"perplexity_search\"") == null);
+}
+
 test "OpenAI Codex request maps supported OpenAI namespace aliases" {
     const messages = [_]types.ChatMessage{
         .{ .role = .user, .content = "Hello" },
-- 
2.47.3

