+
+test "OpenCode models route by namespace and demand the matching credential" {
+    const messages = [_]shared_types.ChatMessage{
+        .{ .role = .user, .content = "Hello" },
+    };
+    const base = agent_stream_provider_contract.BuildRequest{
+        .model = "opencode/kimi-k3",
+        .serialized_tools = "[]",
+        .messages = &messages,
+        .tool_choice = .auto,
+        .provider_options = .{},
+    };
+
+    // No credential, a gateway credential, or a Codex credential: all refuse
+    // an OpenCode model instead of silently misrouting it.
+    for ([_]?credentials.Source{ null, .ai_gateway_api_key, .openai_codex }) |source| {
+        var request = base;
+        request.credential_source = source;
+        try std.testing.expectError(
+            error.OpenCodeCredentialRequired,
+            agent_stream_provider.build(std.testing.allocator, request),
+        );
+    }
+
+    // The OpenCode credential with a gateway model is refused symmetrically.
+    try std.testing.expectError(error.OpenCodeModelRequired, agent_stream_provider.build(std.testing.allocator, .{
+        .credential_source = .opencode,
+        .model = "zai/glm-5.2",
+        .serialized_tools = "[]",
+        .messages = &messages,
+        .tool_choice = .auto,
+        .provider_options = .{},
+    }));
+
+    // The matching pair builds an OpenAI chat completions payload.
+    const body = try agent_stream_provider.build(std.testing.allocator, .{
+        .credential_source = .opencode,
+        .model = "opencode-go/kimi-k3",
+        .serialized_tools = "[]",
+        .messages = &messages,
+        .tool_choice = .auto,
+        .provider_options = .{},
+    });
+    defer std.testing.allocator.free(body);
+    try std.testing.expect(std.mem.indexOf(u8, body, "\"model\":\"kimi-k3\"") != null);
+}
+
+test "OpenCode namespaces stay distinct from gateway and Codex namespaces" {
+    // opencode/ vs openai-codex/ vs openai/ must never collide on prefix.
+    try std.testing.expect(opencode_gateway.isModel("opencode/kimi-k3"));
+    try std.testing.expect(opencode_gateway.isModel("opencode-go/kimi-k3"));
+    try std.testing.expect(!opencode_gateway.isModel("openai/gpt-5.6-luna"));
+    try std.testing.expect(!opencode_gateway.isModel("openai-codex/gpt-5.6-sol"));
+    try std.testing.expect(!openai_codex_gateway.isModel("opencode/kimi-k3"));
+    try std.testing.expect(openai_codex_gateway.isModel("openai-codex/gpt-5.6-sol"));
+}
