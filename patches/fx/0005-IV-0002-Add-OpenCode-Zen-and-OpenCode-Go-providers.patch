diff --git a/src/gateway/opencode.zig b/src/gateway/opencode.zig
new file mode 100644
index 0000000..19278a2
--- /dev/null
+++ b/src/gateway/opencode.zig
@@ -0,0 +1,769 @@
+const std = @import("std");
+const agent_stream_provider = @import("../core/agent/stream_provider.zig");
+const gateway_client = @import("client.zig");
+const io_mod = @import("../core/shared/io.zig");
+const opencode_auth = @import("../core/auth/opencode.zig");
+const types = @import("../core/shared/types.zig");
+
+const Allocator = std.mem.Allocator;
+
+pub const model_prefix = opencode_auth.model_prefix;
+pub const go_model_prefix = opencode_auth.go_model_prefix;
+const max_error_body_bytes: usize = 64 * 1024;
+const max_sse_line_bytes: usize = 1024 * 1024;
+
+pub fn isModel(model: []const u8) bool {
+    return opencode_auth.isModel(model);
+}
+
+pub fn buildRequest(
+    alloc: Allocator,
+    request: agent_stream_provider.BuildRequest,
+) ![]u8 {
+    const model_id = opencode_auth.requestModelId(request.model) orelse
+        return error.InvalidOpenCodeModel;
+    if (request.verified_images != null or request.vision_mode == .required) {
+        return error.OpenCodeImagesUnsupported;
+    }
+    if (request.response_format != null) return error.OpenCodeStructuredResponseUnsupported;
+
+    var tools: std.Io.Writer.Allocating = .init(alloc);
+    defer tools.deinit();
+    var tool_count: usize = 0;
+    try writeSerializedToolArray(alloc, &tools.writer, &tool_count, request.serialized_tools);
+    for (request.selected_dynamic_tool_schemas) |schema| {
+        var parsed = try std.json.parseFromSlice(std.json.Value, alloc, schema, .{});
+        defer parsed.deinit();
+        try writeToolSchema(&tools.writer, &tool_count, parsed.value);
+    }
+
+    var out: std.Io.Writer.Allocating = .init(alloc);
+    errdefer out.deinit();
+    const writer = &out.writer;
+    try writer.writeAll("{\"model\":");
+    try std.json.Stringify.value(model_id, .{}, writer);
+    try writer.writeAll(",\"stream\":true,\"stream_options\":{\"include_usage\":true},\"messages\":[");
+
+    var first_message = true;
+    for (request.messages) |message| {
+        try writeMessage(writer, &first_message, message);
+    }
+    try writer.writeAll("]");
+
+    if (tool_count > 0) {
+        try writer.writeAll(",\"tools\":[");
+        try writer.writeAll(tools.written());
+        try writer.writeAll("],\"tool_choice\":");
+        try std.json.Stringify.value(request.tool_choice.label(), .{}, writer);
+    }
+    if (request.max_output_tokens) |max_tokens| {
+        if (max_tokens > 0) {
+            try writer.print(",\"max_tokens\":{d}", .{max_tokens});
+        }
+    }
+    try writer.writeByte('}');
+    return out.toOwnedSlice();
+}
+
+fn writeMessage(
+    writer: *std.Io.Writer,
+    first: *bool,
+    message: types.ChatMessage,
+) !void {
+    try writeSeparator(writer, first);
+    switch (message.role) {
+        .system => {
+            try writer.writeAll("{\"role\":\"system\",\"content\":");
+            try std.json.Stringify.value(message.content orelse "", .{}, writer);
+            try writer.writeByte('}');
+        },
+        .user => {
+            try writer.writeAll("{\"role\":\"user\",\"content\":");
+            try std.json.Stringify.value(message.content orelse "", .{}, writer);
+            try writer.writeByte('}');
+        },
+        .assistant => {
+            const content = message.content orelse "";
+            try writer.writeAll("{\"role\":\"assistant\",\"content\":");
+            if (content.len == 0 and message.tool_calls.len > 0) {
+                try writer.writeAll("null");
+            } else {
+                try std.json.Stringify.value(content, .{}, writer);
+            }
+            if (message.tool_calls.len > 0) {
+                try writer.writeAll(",\"tool_calls\":[");
+                var first_call = true;
+                for (message.tool_calls) |call| {
+                    try writeSeparator(writer, &first_call);
+                    try writer.writeAll("{\"id\":");
+                    try std.json.Stringify.value(call.id, .{}, writer);
+                    try writer.writeAll(",\"type\":\"function\",\"function\":{\"name\":");
+                    try std.json.Stringify.value(call.name, .{}, writer);
+                    try writer.writeAll(",\"arguments\":");
+                    try std.json.Stringify.value(call.arguments_json, .{}, writer);
+                    try writer.writeAll("}}");
+                }
+                try writer.writeByte(']');
+            }
+            try writer.writeByte('}');
+        },
+        .tool => {
+            const call_id = message.tool_call_id orelse return error.OpenCodeToolCallIdMissing;
+            try writer.writeAll("{\"role\":\"tool\",\"tool_call_id\":");
+            try std.json.Stringify.value(call_id, .{}, writer);
+            try writer.writeAll(",\"content\":");
+            try std.json.Stringify.value(message.content orelse "", .{}, writer);
+            try writer.writeByte('}');
+        },
+    }
+}
+
+fn writeSeparator(writer: *std.Io.Writer, first: *bool) !void {
+    if (!first.*) try writer.writeByte(',');
+    first.* = false;
+}
+
+/// Converts fx tool schemas (`inputSchema`) into OpenAI chat completions
+/// function tools. AI Gateway provider advertisements are not local functions
+/// and cannot execute on the OpenCode gateways, so they are skipped.
+fn writeSerializedToolArray(
+    alloc: Allocator,
+    writer: *std.Io.Writer,
+    count: *usize,
+    serialized_tools: []const u8,
+) !void {
+    var parsed = try std.json.parseFromSlice(std.json.Value, alloc, serialized_tools, .{});
+    defer parsed.deinit();
+    if (parsed.value != .array) return error.InvalidOpenCodeTools;
+    for (parsed.value.array.items) |tool| {
+        if (isGatewayProviderAdvertisement(tool)) continue;
+        try writeToolSchema(writer, count, tool);
+    }
+}
+
+fn isGatewayProviderAdvertisement(tool: std.json.Value) bool {
+    if (tool != .object) return false;
+    const tool_type = tool.object.get("type") orelse return false;
+    return tool_type == .string and std.mem.eql(u8, tool_type.string, "provider");
+}
+
+fn writeToolSchema(writer: *std.Io.Writer, count: *usize, tool: std.json.Value) !void {
+    if (tool != .object) return error.InvalidOpenCodeTool;
+    const name = tool.object.get("name") orelse return error.InvalidOpenCodeTool;
+    const description = tool.object.get("description") orelse return error.InvalidOpenCodeTool;
+    const parameters = tool.object.get("inputSchema") orelse
+        tool.object.get("parameters") orelse return error.InvalidOpenCodeTool;
+    if (name != .string or description != .string or parameters != .object) {
+        return error.InvalidOpenCodeTool;
+    }
+    if (count.* > 0) try writer.writeByte(',');
+    count.* += 1;
+    try writer.writeAll("{\"type\":\"function\",\"function\":{\"name\":");
+    try std.json.Stringify.value(name.string, .{}, writer);
+    try writer.writeAll(",\"description\":");
+    try std.json.Stringify.value(description.string, .{}, writer);
+    try writer.writeAll(",\"parameters\":");
+    try std.json.Stringify.value(parameters, .{}, writer);
+    try writer.writeAll("}}");
+}
+
+pub fn stream(
+    alloc: Allocator,
+    request: agent_stream_provider.Request,
+) !agent_stream_provider.Result {
+    const chat_url = opencode_auth.chatUrlForModel(request.model) orelse
+        return error.InvalidOpenCodeModel;
+    if (request.api_key.len == 0) return error.OpenCodeCredentialRequired;
+    if (request.cancel_flag.load(.seq_cst)) return error.Cancelled;
+
+    const uri = try std.Uri.parse(chat_url);
+    const auth_header = try std.fmt.allocPrint(alloc, "Bearer {s}", .{request.api_key});
+    defer alloc.free(auth_header);
+
+    var client: std.http.Client = .{ .allocator = alloc, .io = io_mod.getIo() };
+    defer client.deinit();
+    var http_request = try client.request(.POST, uri, .{
+        .headers = .{
+            .content_type = .{ .override = "application/json" },
+            .authorization = .{ .override = auth_header },
+            .accept_encoding = .omit,
+            .user_agent = .{ .override = gateway_client.user_agent },
+        },
+        .extra_headers = &.{},
+        .keep_alive = false,
+        .redirect_behavior = .unhandled,
+    });
+    defer http_request.deinit();
+
+    http_request.transfer_encoding = .{ .content_length = request.payload.len };
+    var send_buffer: [8192]u8 = undefined;
+    request.delivery.markPossiblySent();
+    var body_writer = try http_request.sendBodyUnflushed(&send_buffer);
+    try body_writer.writer.writeAll(request.payload);
+    try body_writer.end();
+    try http_request.connection.?.flush();
+    if (request.cancel_flag.load(.seq_cst)) return error.Cancelled;
+
+    var response = try http_request.receiveHead(&.{});
+    if (response.head.status != .ok) {
+        var error_buffer: [max_error_body_bytes]u8 = undefined;
+        var error_writer = std.Io.Writer.fixed(&error_buffer);
+        var transfer_buffer: [4096]u8 = undefined;
+        const error_reader = response.reader(&transfer_buffer);
+        _ = error_reader.streamRemaining(&error_writer) catch {};
+        return .{
+            .status = response.head.status,
+            .err_body = try alloc.dupe(u8, error_writer.buffered()),
+            .ownership = .owned,
+        };
+    }
+
+    request.attempt_evidence.provider_admitted = true;
+    var transfer_buffer: [8192]u8 = undefined;
+    const reader = response.reader(&transfer_buffer);
+    const completion = try consumeSseStream(alloc, reader, request);
+    return .{
+        .status = .ok,
+        .completion = completion,
+        .reconcile_generation_usage = false,
+        .ownership = .owned,
+    };
+}
+
+const SseReader = struct {
+    pending: std.ArrayList(u8) = .empty,
+
+    fn deinit(self: *SseReader, alloc: Allocator) void {
+        self.pending.deinit(alloc);
+    }
+
+    fn release(self: *SseReader) void {
+        self.pending.clearRetainingCapacity();
+    }
+
+    fn next(self: *SseReader, alloc: Allocator, reader: *std.Io.Reader) !?[]const u8 {
+        while (true) {
+            const fragment = reader.takeDelimiter('\n') catch |err| switch (err) {
+                error.StreamTooLong => {
+                    const buffered = reader.buffered();
+                    if (buffered.len == 0) return error.OpenCodeSseReadStalled;
+                    if (buffered.len > max_sse_line_bytes - self.pending.items.len) {
+                        return error.OpenCodeSseEventTooLarge;
+                    }
+                    try self.pending.appendSlice(alloc, buffered);
+                    reader.tossBuffered();
+                    continue;
+                },
+                error.ReadFailed => return error.ReadFailed,
+            } orelse {
+                if (self.pending.items.len > 0) return self.pending.items;
+                return null;
+            };
+            if (fragment.len > max_sse_line_bytes - self.pending.items.len) {
+                return error.OpenCodeSseEventTooLarge;
+            }
+            if (self.pending.items.len == 0) return fragment;
+            try self.pending.appendSlice(alloc, fragment);
+            return self.pending.items;
+        }
+    }
+};
+
+/// One in-flight streamed tool call, keyed by its `tool_calls[].index`.
+const ToolCallAccumulator = struct {
+    index: u64,
+    id: std.ArrayList(u8) = .empty,
+    name: std.ArrayList(u8) = .empty,
+    arguments: std.ArrayList(u8) = .empty,
+    announced: bool = false,
+
+    fn deinit(self: *ToolCallAccumulator, alloc: Allocator) void {
+        self.id.deinit(alloc);
+        self.name.deinit(alloc);
+        self.arguments.deinit(alloc);
+    }
+
+    fn ready(self: *const ToolCallAccumulator) bool {
+        return self.id.items.len > 0 and self.name.items.len > 0;
+    }
+};
+
+fn findAccumulator(
+    accumulators: []ToolCallAccumulator,
+    index: u64,
+) ?*ToolCallAccumulator {
+    for (accumulators) |*accumulator| {
+        if (accumulator.index == index) return accumulator;
+    }
+    return null;
+}
+
+fn consumeSseStream(
+    alloc: Allocator,
+    reader: *std.Io.Reader,
+    request: agent_stream_provider.Request,
+) !types.GatewayCompletion {
+    var content: std.ArrayList(u8) = .empty;
+    defer content.deinit(alloc);
+    var accumulators: std.ArrayList(ToolCallAccumulator) = .empty;
+    defer {
+        for (accumulators.items) |*accumulator| accumulator.deinit(alloc);
+        accumulators.deinit(alloc);
+    }
+    var provider_failure_detail: ?[]u8 = null;
+    errdefer if (provider_failure_detail) |detail| alloc.free(detail);
+    var usage: types.Usage = .{};
+    var finish_reason: ?types.ProviderFinishReason = null;
+    var saw_done = false;
+    var provider_failed = false;
+    var sse_reader: SseReader = .{};
+    defer sse_reader.deinit(alloc);
+
+    while (!saw_done and !provider_failed) {
+        if (request.cancel_flag.load(.seq_cst)) return error.Cancelled;
+        const raw_line = (try sse_reader.next(alloc, reader)) orelse break;
+        defer sse_reader.release();
+        const line = std.mem.trim(u8, raw_line, "\r");
+        if (line.len == 0 or line[0] == ':') continue;
+        const prefix = "data:";
+        if (!std.mem.startsWith(u8, line, prefix)) continue;
+        const data = std.mem.trimStart(u8, line[prefix.len..], " ");
+        if (std.mem.eql(u8, data, "[DONE]")) {
+            saw_done = true;
+            break;
+        }
+
+        var parsed = std.json.parseFromSlice(std.json.Value, alloc, data, .{}) catch |err| {
+            if (err == error.OutOfMemory) return err;
+            continue;
+        };
+        defer parsed.deinit();
+        if (parsed.value != .object) continue;
+        const root = parsed.value.object;
+
+        if (root.get("error")) |error_value| {
+            const detail = errorMessageValue(error_value) orelse "OpenCode response failed";
+            provider_failure_detail = try alloc.dupe(u8, detail);
+            finish_reason = .provider_error;
+            provider_failed = true;
+            break;
+        }
+
+        if (root.get("usage")) |usage_value| {
+            if (usage_value == .object) usage = parseUsage(usage_value.object);
+        }
+
+        const choices_value = root.get("choices") orelse continue;
+        if (choices_value != .array) continue;
+        for (choices_value.array.items) |choice_value| {
+            if (choice_value != .object) continue;
+            const choice = choice_value.object;
+
+            if (choice.get("finish_reason")) |finish_value| {
+                if (finish_value == .string) {
+                    finish_reason = mapFinishReason(finish_value.string);
+                }
+            }
+
+            const delta_value = choice.get("delta") orelse continue;
+            if (delta_value != .object) continue;
+            const delta = delta_value.object;
+
+            if (stringField(delta, "content")) |text_delta| {
+                if (text_delta.len > 0) {
+                    request.on_content_chunk(request.callback_ctx, text_delta);
+                    try appendCaptured(alloc, &content, text_delta, request.content_capture_limit);
+                }
+            }
+
+            if (reasoningDelta(delta)) |reasoning_delta| {
+                if (request.on_reasoning_chunk) |callback| callback(request.callback_ctx, reasoning_delta);
+            }
+
+            const tool_calls_value = delta.get("tool_calls") orelse continue;
+            if (tool_calls_value != .array) continue;
+            for (tool_calls_value.array.items) |streamed_value| {
+                if (streamed_value != .object) continue;
+                const streamed = streamed_value.object;
+                const index = nonNegativeInteger(streamed.get("index")) orelse 0;
+                var accumulator = findAccumulator(accumulators.items, index) orelse blk: {
+                    try accumulators.append(alloc, .{ .index = index });
+                    break :blk &accumulators.items[accumulators.items.len - 1];
+                };
+                if (stringField(streamed, "id")) |id| {
+                    if (id.len > 0 and accumulator.id.items.len == 0) {
+                        try accumulator.id.appendSlice(alloc, id);
+                    }
+                }
+                if (streamed.get("function")) |function_value| {
+                    if (function_value == .object) {
+                        const function = function_value.object;
+                        if (stringField(function, "name")) |name| {
+                            if (name.len > 0) try accumulator.name.appendSlice(alloc, name);
+                        }
+                        if (stringField(function, "arguments")) |arguments| {
+                            if (arguments.len > 0) {
+                                try accumulator.arguments.appendSlice(alloc, arguments);
+                                if (request.on_tool_input_chunk) |callback| {
+                                    callback(request.callback_ctx, arguments);
+                                }
+                            }
+                        }
+                    }
+                }
+                if (!accumulator.announced and accumulator.ready()) {
+                    accumulator.announced = true;
+                    if (request.on_tool_start) |callback| {
+                        callback(
+                            request.callback_ctx,
+                            accumulator.id.items,
+                            accumulator.name.items,
+                            null,
+                        );
+                    }
+                }
+            }
+        }
+    }
+
+    // Some OpenAI-compatible backends close the stream after the terminal
+    // finish_reason without a [DONE] sentinel. Accept that ending when a
+    // terminal state was observed; only an unexplained early end fails.
+    const observed_finish = finish_reason != null and finish_reason.? != .provider_error;
+    if (!saw_done and !provider_failed and !observed_finish) {
+        return error.OpenCodeStreamEndedEarly;
+    }
+
+    var owned_tools: std.ArrayList(types.ToolCall) = .empty;
+    errdefer for (owned_tools.items) |call| types.freeToolCall(alloc, call);
+    for (accumulators.items) |*accumulator| {
+        if (accumulator.id.items.len == 0 and accumulator.name.items.len == 0) continue;
+        const owned_id = try alloc.dupe(u8, accumulator.id.items);
+        errdefer alloc.free(owned_id);
+        const owned_name = try alloc.dupe(u8, accumulator.name.items);
+        errdefer alloc.free(owned_name);
+        const owned_arguments = try alloc.dupe(u8, accumulator.arguments.items);
+        errdefer alloc.free(owned_arguments);
+        try owned_tools.append(alloc, .{
+            .id = owned_id,
+            .name = owned_name,
+            .arguments_json = owned_arguments,
+            .argument_integrity = try types.ToolArgumentIntegrity.classifySerialized(
+                alloc,
+                accumulator.arguments.items,
+            ),
+        });
+    }
+
+    const finish = finish_reason orelse
+        if (owned_tools.items.len > 0) types.ProviderFinishReason.tool_calls else .stop;
+    const owned_content: ?[]u8 = if (content.items.len > 0) try content.toOwnedSlice(alloc) else null;
+    errdefer if (owned_content) |value| alloc.free(value);
+    const tools_slice = try owned_tools.toOwnedSlice(alloc);
+    return .{
+        .content = owned_content,
+        .tool_calls = tools_slice,
+        .provider_failure_detail = provider_failure_detail,
+        .finish_reason = finish,
+        .usage = usage,
+    };
+}
+
+/// Chat completions providers stream reasoning under several field names;
+/// use the first non-empty one to avoid duplicated thinking output.
+fn reasoningDelta(delta: std.json.ObjectMap) ?[]const u8 {
+    const fields = [_][]const u8{ "reasoning_content", "reasoning", "reasoning_text" };
+    for (fields) |field| {
+        const value = stringField(delta, field) orelse continue;
+        if (value.len > 0) return value;
+    }
+    return null;
+}
+
+fn mapFinishReason(raw: []const u8) types.ProviderFinishReason {
+    if (std.mem.eql(u8, raw, "stop")) return .stop;
+    if (std.mem.eql(u8, raw, "length")) return .length;
+    if (std.mem.eql(u8, raw, "content_filter")) return .content_filter;
+    if (std.mem.eql(u8, raw, "tool_calls") or std.mem.eql(u8, raw, "function_call")) {
+        return .tool_calls;
+    }
+    return .other;
+}
+
+fn appendCaptured(
+    alloc: Allocator,
+    content: *std.ArrayList(u8),
+    delta: []const u8,
+    limit: ?usize,
+) !void {
+    const remaining = if (limit) |maximum| maximum -| @min(maximum, content.items.len) else delta.len;
+    try content.appendSlice(alloc, delta[0..@min(delta.len, remaining)]);
+}
+
+fn parseUsage(object: std.json.ObjectMap) types.Usage {
+    return .{
+        .input_tokens = nonNegativeInteger(object.get("prompt_tokens")),
+        .output_tokens = nonNegativeInteger(object.get("completion_tokens")),
+    };
+}
+
+fn errorMessageValue(value: std.json.Value) ?[]const u8 {
+    switch (value) {
+        .string => |text| return text,
+        .object => |object| {
+            if (stringField(object, "message")) |message| return message;
+            return null;
+        },
+        else => return null,
+    }
+}
+
+fn stringField(object: std.json.ObjectMap, key: []const u8) ?[]const u8 {
+    const value = object.get(key) orelse return null;
+    return if (value == .string) value.string else null;
+}
+
+fn nonNegativeInteger(value: ?std.json.Value) ?u64 {
+    const actual = value orelse return null;
+    if (actual != .integer or actual.integer < 0) return null;
+    return @intCast(actual.integer);
+}
+
+test "OpenCode request maps messages tools and namespaces" {
+    const tools =
+        "[{\"type\":\"function\",\"name\":\"read_file\",\"description\":\"Read\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}]";
+    const calls = [_]types.ToolCall{.{
+        .id = "call_1",
+        .name = "read_file",
+        .arguments_json = "{\"path\":\"README.md\"}",
+    }};
+    const messages = [_]types.ChatMessage{
+        .{ .role = .system, .content = "Be concise." },
+        .{ .role = .user, .content = "Read it" },
+        .{ .role = .assistant, .content = "Opening it.", .tool_calls = &calls },
+        .{ .role = .tool, .tool_call_id = "call_1", .content = "contents" },
+    };
+    for ([_][]const u8{ "opencode/kimi-k3", "opencode-go/kimi-k3" }) |model| {
+        const body = try buildRequest(std.testing.allocator, .{
+            .credential_source = .opencode,
+            .model = model,
+            .serialized_tools = tools,
+            .messages = &messages,
+            .tool_choice = .auto,
+            .vision_mode = .optional,
+            .provider_options = .{},
+        });
+        defer std.testing.allocator.free(body);
+        try std.testing.expect(std.mem.indexOf(u8, body, "\"model\":\"kimi-k3\"") != null);
+        try std.testing.expect(std.mem.indexOf(u8, body, "\"stream\":true") != null);
+        try std.testing.expect(std.mem.indexOf(u8, body, "\"role\":\"system\"") != null);
+        try std.testing.expect(std.mem.indexOf(u8, body, "\"role\":\"tool\",\"tool_call_id\":\"call_1\"") != null);
+        try std.testing.expect(std.mem.indexOf(u8, body, "\"type\":\"function\",\"function\":{\"name\":\"read_file\"") != null);
+        try std.testing.expect(std.mem.indexOf(u8, body, "\"tool_choice\":\"auto\"") != null);
+        try std.testing.expect(std.mem.indexOf(u8, body, "\"inputSchema\"") == null);
+    }
+}
+
