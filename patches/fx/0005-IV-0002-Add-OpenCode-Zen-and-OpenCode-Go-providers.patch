+fn runOpenCodeLogin(
+    alloc: Allocator,
+    deps: RunDeps,
+    provider_arg: []const u8,
+    key_arg: ?[]const u8,
+) !RunResult {
+    const go_fleet = std.mem.eql(u8, provider_arg, "opencode-go") or
+        std.mem.eql(u8, provider_arg, "go");
+    const label = if (go_fleet) "fx login opencode-go" else "fx login opencode";
+
+    const api_key: []u8 = if (key_arg) |value|
+        try alloc.dupe(u8, value)
+    else blk: {
+        try writeStdout(deps, "OpenCode API key: ");
+        break :blk opencode_auth.readApiKeyFromStdin(alloc) catch |err| switch (err) {
+            error.OutOfMemory => return err,
+            else => {
+                try writeLabeledStderr(alloc, deps, label, "could not read the API key from stdin");
+                return .handled_failure;
+            },
+        } orelse {
+            try writeLabeledStderr(alloc, deps, label, "no API key provided");
+            return .handled_failure;
+        };
+    };
+    defer secret.zeroAndFree(alloc, api_key);
+
+    opencode_auth.saveApiKey(alloc, api_key) catch {
