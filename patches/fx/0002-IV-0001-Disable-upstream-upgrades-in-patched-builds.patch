From 296797e75c023a485d2dfdecb5216a4d2c9e5333 Mon Sep 17 00:00:00 2001
From: iamwrm <22743891+iamwrm@users.noreply.github.com>
Date: Thu, 20 Aug 2026 18:07:49 +0900
Subject: [PATCH] IV-0001 Disable upstream upgrades in patched builds

---
 README.md                         |  2 ++
 src/core/cli/cli_surface.zig      | 18 ++++++++++++++++++
 src/core/fork_build.zig           |  8 ++++++++
 src/core/upgrade/auto_upgrade.zig |  2 ++
 src/openai_codex_test.zig         |  1 +
 5 files changed, 31 insertions(+)
 create mode 100644 src/core/fork_build.zig

diff --git a/README.md b/README.md
index 50089b7..29574fa 100644
--- a/README.md
+++ b/README.md
@@ -47,6 +47,8 @@ fx login openai-codex
 
 This stores a refreshable OpenAI session in the fx profile and selects `openai-codex/gpt-5.6-sol`. Use `fx logout openai-codex` to remove it. Codex subscription requests go directly to the ChatGPT Codex Responses endpoint and are not sent through Vercel AI Gateway.
 
+This patched build does not use fx's upstream auto-upgrade channel because an official upgrade would remove the Codex subscription transport. Install patched updates from [iamwrm/fx-fork releases](https://github.com/iamwrm/fx-fork/releases).
+
 Run fx from a project:
 
 ```bash
diff --git a/src/core/cli/cli_surface.zig b/src/core/cli/cli_surface.zig
index 1697a58..969b09d 100644
--- a/src/core/cli/cli_surface.zig
+++ b/src/core/cli/cli_surface.zig
@@ -13,6 +13,7 @@ const config_runtime = @import("../config/config_runtime.zig");
 const devbox_executor = @import("../execution/devbox_executor.zig");
 const doctor_runtime = @import("doctor_runtime.zig");
 const gateway_provider = @import("../gateway/gateway_provider.zig");
+const fork_build = @import("../fork_build.zig");
 const model_catalog = @import("../gateway/model_catalog.zig");
 const background_process_provider = @import(
     "../execution/background_process_provider.zig",
@@ -1377,6 +1378,23 @@ fn runNonInteractiveWithDeps(
                 try writeUsageOrJsonError(alloc, cfg.command_catalog, deps, .upgrade, "upgrade", err, rest);
                 return .handled_failure;
             };
+            if (fork_build.enabled) {
+                if (opts.format == .json) {
+                    try writeJsonCommandFailure(
+                        alloc,
+                        deps,
+                        "upgrade",
+                        error.ForkBuildUpgradesDisabled,
+                        "upstream upgrades are disabled for this patched build; install updates from " ++ fork_build.releases_url,
+                    );
+                } else {
+                    try writeStderr(
+                        deps,
+                        "fx upgrade: upstream upgrades are disabled for this patched build; install updates from " ++ fork_build.releases_url ++ "\n",
+                    );
+                }
+                return .handled_failure;
+            }
 
             var startup = deps.load_startup_state_without_credentials(
                 alloc,
diff --git a/src/core/fork_build.zig b/src/core/fork_build.zig
new file mode 100644
index 0000000..73107e7
--- /dev/null
+++ b/src/core/fork_build.zig
@@ -0,0 +1,8 @@
+const std = @import("std");
+
+pub const enabled = true;
+pub const releases_url = "https://github.com/iamwrm/fx-fork/releases";
+
+test "OpenAI Codex fork build stays on the patched release channel" {
+    try std.testing.expect(enabled);
+}
diff --git a/src/core/upgrade/auto_upgrade.zig b/src/core/upgrade/auto_upgrade.zig
index f1087e7..a0af8db 100644
--- a/src/core/upgrade/auto_upgrade.zig
+++ b/src/core/upgrade/auto_upgrade.zig
@@ -1,5 +1,6 @@
 const std = @import("std");
 const io_mod = @import("../shared/io.zig");
+const fork_build = @import("../fork_build.zig");
 const helpers = @import("upgrade_helpers.zig");
 const update_target = @import("update_target.zig");
 
@@ -28,6 +29,7 @@ pub const RelaunchRequest = struct {
 };
 
 pub fn shouldEnableForCurrentExecutable() bool {
+    if (fork_build.enabled) return false;
     var exe_buf: [std.fs.max_path_bytes]u8 = undefined;
     const n = std.process.executablePath(io_mod.getIo(), &exe_buf) catch return true;
     return !isDevelopmentBuildPath(exe_buf[0..n]);
diff --git a/src/openai_codex_test.zig b/src/openai_codex_test.zig
index 94891f5..770950f 100644
--- a/src/openai_codex_test.zig
+++ b/src/openai_codex_test.zig
@@ -1,5 +1,6 @@
 test {
     _ = @import("core/auth/openai_codex.zig");
     _ = @import("core/auth/credentials.zig");
+    _ = @import("core/fork_build.zig");
     _ = @import("gateway/openai_codex.zig");
 }
-- 
