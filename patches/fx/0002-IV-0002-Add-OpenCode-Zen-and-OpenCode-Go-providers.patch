+/// Loads the OpenCode API key (environment first, then the stored key file).
+/// The key is static, so both load modes behave identically.
+pub fn loadOpenCodeCredential(alloc: std.mem.Allocator) !?Credential {
+    const api_key = (try opencode.loadApiKey(alloc)) orelse return null;
+    return .{ .token = api_key, .source = .opencode };
+}
diff --git a/src/core/auth/opencode.zig b/src/core/auth/opencode.zig
new file mode 100644
index 0000000..0403f4a
--- /dev/null
+++ b/src/core/auth/opencode.zig
@@ -0,0 +1,262 @@
+const std = @import("std");
+const debug_trace = @import("../shared/debug_trace.zig");
+const host_target = @import("../hosts/target.zig");
+const io_mod = @import("../shared/io.zig");
+const profile_paths = @import("../shared/profile_paths.zig");
+const secret = @import("secret.zig");
+const types = @import("../shared/types.zig");
+
+const Allocator = std.mem.Allocator;
+
+/// Model namespaces served by the OpenCode gateways. Both fleets accept the
+/// same OpenCode API key, so one credential source covers both prefixes.
+pub const model_prefix = "opencode/";
+pub const go_model_prefix = "opencode-go/";
+pub const env_var_name = "OPENCODE_API_KEY";
+pub const credential_source: types.CredentialSource = .opencode;
+
+/// OpenAI-compatible chat endpoints behind opencode.ai. `api.opencode.ai` is
+/// a different service and must not be used for model traffic.
+pub const zen_chat_url = "https://opencode.ai/zen/v1/chat/completions";
+pub const go_chat_url = "https://opencode.ai/zen/go/v1/chat/completions";
+
+const auth_file_name = "opencode-auth.json";
+const lock_file_name = "opencode-auth.lock";
+const max_auth_file_bytes: usize = 64 * 1024;
+const mutation_lock_deadline_ms: u64 = 2000;
+const max_api_key_input_bytes: usize = 512;
+
+pub const AuthError = error{
+    InvalidApiKey,
+    InvalidResponse,
+    HomeNotSet,
+};
+
+pub fn isModel(model: []const u8) bool {
+    return isZenModel(model) or isGoModel(model);
+}
+
+pub fn isZenModel(model: []const u8) bool {
+    return std.mem.startsWith(u8, model, model_prefix) and model.len > model_prefix.len;
+}
+
+pub fn isGoModel(model: []const u8) bool {
+    return std.mem.startsWith(u8, model, go_model_prefix) and model.len > go_model_prefix.len;
+}
+
+/// Strips the provider namespace from a model id. The bare id is what the
+/// OpenCode gateway expects on the wire.
+pub fn requestModelId(model: []const u8) ?[]const u8 {
+    if (isZenModel(model)) return model[model_prefix.len..];
+    if (isGoModel(model)) return model[go_model_prefix.len..];
+    return null;
+}
+
+/// Chat completions endpoint for a namespaced model id.
+pub fn chatUrlForModel(model: []const u8) ?[]const u8 {
+    if (isZenModel(model)) return zen_chat_url;
+    if (isGoModel(model)) return go_chat_url;
+    return null;
+}
+
+/// Resolves the OpenCode API key: environment first, then the stored key file.
+/// Returned bytes are owned by the caller and must be released with
+/// `secret.zeroAndFree`.
+pub fn loadApiKey(alloc: Allocator) !?[]u8 {
+    if (io_mod.getenv(env_var_name)) |value| {
+        if (value.len > 0) return try alloc.dupe(u8, value);
+    }
+    if (comptime host_target.is_wasm) return null;
+    return loadStoredApiKey(alloc);
+}
+
+pub fn exists(alloc: Allocator) !bool {
+    if (nonEmptyEnvValue(env_var_name)) return true;
+    if (comptime host_target.is_wasm) return false;
+    const stored = (try loadStoredApiKey(alloc)) orelse return false;
+    defer secret.zeroAndFree(alloc, stored);
+    return true;
+}
+
+/// Persists the API key under `~/.fx/opencode-auth.json` with private
+/// permissions, mirroring the OpenAI Codex session storage guarantees.
+pub fn saveApiKey(alloc: Allocator, api_key: []const u8) !void {
+    if (api_key.len == 0) return AuthError.InvalidApiKey;
+    var mutation = try beginMutation();
+    defer mutation.deinit();
+    const text = try stringify(alloc, api_key);
+    defer secret.zeroAndFree(alloc, text);
+    try io_mod.durableReplaceVerified(alloc, &mutation.fx_dir, auth_file_name, text);
+}
+
+/// Loads only the stored key file (no environment fallback).
+pub fn loadStoredApiKey(alloc: Allocator) !?[]u8 {
+    const home = io_mod.getenv("HOME") orelse return null;
+    var home_dir = std.Io.Dir.openDirAbsolute(io_mod.getIo(), home, .{ .iterate = true }) catch return null;
+    defer home_dir.close(io_mod.getIo());
+    var fx_dir = home_dir.openDir(io_mod.getIo(), profile_paths.root_dir_name, .{
+        .iterate = true,
+        .follow_symlinks = false,
+    }) catch return null;
+    defer fx_dir.close(io_mod.getIo());
+
+    var file = fx_dir.openFile(io_mod.getIo(), auth_file_name, .{
+        .mode = .read_only,
+        .allow_directory = false,
+        .follow_symlinks = false,
+        .resolve_beneath = true,
+    }) catch |err| switch (err) {
+        error.FileNotFound => return null,
+        else => return err,
+    };
+    defer file.close(io_mod.getIo());
+    const stat = try file.stat(io_mod.getIo());
+    if (stat.kind != .file or stat.permissions.toMode() & 0o077 != 0) {
+        return error.InsecureAuthFile;
+    }
+    const bytes = try io_mod.readFileToEnd(alloc, &file, max_auth_file_bytes);
+    defer secret.zeroAndFree(alloc, bytes);
+    return parseApiKey(alloc, bytes) catch |err| {
+        if (err == error.OutOfMemory) return err;
+        debug_trace.logf("auth", "OpenCode auth parse failed err={s}", .{@errorName(err)});
+        return null;
+    };
+}
+
+/// Removes the stored key file. Returns whether anything was deleted.
+pub fn deleteApiKey() !bool {
+    if (comptime host_target.is_wasm) return false;
+    var mutation = (try beginExistingMutation()) orelse return false;
+    defer mutation.deinit();
+    mutation.fx_dir.dir.deleteFile(io_mod.getIo(), auth_file_name) catch |err| switch (err) {
+        error.FileNotFound => return false,
+        else => return err,
+    };
+    io_mod.syncVerifiedDir(mutation.fx_dir.dir) catch |err| switch (err) {
+        error.OperationUnsupported => {},
+        else => return err,
+    };
+    return true;
+}
+
+fn nonEmptyEnvValue(name: []const u8) bool {
+    const value = io_mod.getenv(name) orelse return false;
+    return value.len > 0;
+}
+
+const Mutation = struct {
+    fx_dir: io_mod.VerifiedDir,
+    lock: io_mod.TimedAdvisoryLock,
+
+    fn deinit(self: *Mutation) void {
+        self.lock.release();
+        self.fx_dir.close();
+        self.* = undefined;
+    }
+};
+
+fn beginMutation() !Mutation {
+    const home = io_mod.getenv("HOME") orelse return AuthError.HomeNotSet;
+    var home_dir = io_mod.VerifiedDir{
+        .dir = try std.Io.Dir.openDirAbsolute(io_mod.getIo(), home, .{ .iterate = true }),
+    };
+    defer home_dir.close();
+    var fx_dir = try io_mod.openOrCreateVerifiedPrivateDir(&home_dir, profile_paths.root_dir_name);
+    errdefer fx_dir.close();
+    const lock = try io_mod.acquireTimedAdvisoryLock(&fx_dir, lock_file_name, mutation_lock_deadline_ms);
+    return .{ .fx_dir = fx_dir, .lock = lock };
+}
+
+fn beginExistingMutation() !?Mutation {
+    if (comptime host_target.is_wasm) return null;
+    const home = io_mod.getenv("HOME") orelse return null;
+    var home_dir = io_mod.VerifiedDir{
+        .dir = try std.Io.Dir.openDirAbsolute(io_mod.getIo(), home, .{ .iterate = true }),
+    };
+    defer home_dir.close();
+    var fx_dir = home_dir.dir.openDir(io_mod.getIo(), profile_paths.root_dir_name, .{
+        .iterate = true,
+        .follow_symlinks = false,
+    }) catch |err| switch (err) {
+        error.FileNotFound => return null,
+        else => return err,
+    };
+    errdefer fx_dir.close(io_mod.getIo());
+    const stat = try fx_dir.stat(io_mod.getIo());
+    if (stat.kind != .directory) return error.DurablePathUnsafe;
+    try fx_dir.setPermissions(io_mod.getIo(), std.Io.File.Permissions.fromMode(0o700));
+    var verified = io_mod.VerifiedDir{ .dir = fx_dir };
+    errdefer verified.close();
+    const lock = try io_mod.acquireTimedAdvisoryLock(&verified, lock_file_name, mutation_lock_deadline_ms);
+    return .{ .fx_dir = verified, .lock = lock };
+}
+
+fn parseApiKey(alloc: Allocator, bytes: []const u8) ![]u8 {
+    var parsed = try std.json.parseFromSlice(std.json.Value, alloc, bytes, .{});
+    defer parsed.deinit();
+    if (parsed.value != .object) return AuthError.InvalidResponse;
+    const object = parsed.value.object;
+    const version = object.get("version") orelse return AuthError.InvalidResponse;
+    if (version != .integer or version.integer != 1) return AuthError.InvalidResponse;
+    const api_key_value = object.get("api_key") orelse return AuthError.InvalidResponse;
+    if (api_key_value != .string or api_key_value.string.len == 0) return AuthError.InvalidResponse;
+    return alloc.dupe(u8, api_key_value.string);
+}
+
+fn stringify(alloc: Allocator, api_key: []const u8) ![]u8 {
+    var out: std.Io.Writer.Allocating = .init(alloc);
+    errdefer out.deinit();
+    try out.writer.writeAll("{\"version\":1,\"api_key\":");
+    try std.json.Stringify.value(api_key, .{}, &out.writer);
+    try out.writer.writeAll("}\n");
+    return out.toOwnedSlice();
+}
+
+test "OpenCode model namespaces route to distinct gateways" {
+    try std.testing.expectEqualStrings("kimi-k2.7-code", requestModelId("opencode/kimi-k2.7-code").?);
+    try std.testing.expectEqualStrings("kimi-k2.7-code", requestModelId("opencode-go/kimi-k2.7-code").?);
+    try std.testing.expectEqualStrings(
+        "https://opencode.ai/zen/v1/chat/completions",
+        chatUrlForModel("opencode/kimi-k3").?,
+    );
+    try std.testing.expectEqualStrings(
+        "https://opencode.ai/zen/go/v1/chat/completions",
+        chatUrlForModel("opencode-go/kimi-k3").?,
+    );
+    try std.testing.expect(chatUrlForModel("openai-codex/gpt-5.6-sol") == null);
+    try std.testing.expect(chatUrlForModel("openai/gpt-5.6-luna") == null);
+    try std.testing.expect(chatUrlForModel("zai/glm-5.2") == null);
+    try std.testing.expect(requestModelId("opencode/") == null);
+    try std.testing.expect(requestModelId("opencode-go/") == null);
+    try std.testing.expect(isModel("opencode-go/deepseek-v4-flash"));
+    try std.testing.expect(!isModel("opencode"));
+    try std.testing.expect(!isModel("opencode-go"));
+}
+
+/// Reads one line from stdin and trims surrounding whitespace. Returns null
+/// for an empty line so callers can treat it as "nothing provided".
+pub fn readApiKeyFromStdin(alloc: Allocator) !?[]u8 {
+    if (comptime host_target.is_wasm) return error.OpenCodeUnavailable;
+    var line: std.ArrayList(u8) = .empty;
+    errdefer line.deinit(alloc);
+    const stdin = std.Io.File.stdin();
+    var chunk: [1]u8 = undefined;
+    while (true) {
+        const read = try stdin.readStreaming(io_mod.getIo(), &.{chunk[0..]});
+        if (read == 0) break;
+        const byte = chunk[0];
+        if (byte == '\n') break;
+        if (line.items.len >= max_api_key_input_bytes) return AuthError.InvalidApiKey;
+        try line.append(alloc, byte);
+    }
+    const trimmed = std.mem.trim(u8, line.items, " \t\r");
+    if (trimmed.len == 0) {
+        line.deinit(alloc);
+        return null;
+    }
+    if (trimmed.ptr != line.items.ptr) {
+        std.mem.copyForwards(u8, line.items, trimmed);
+        line.shrinkRetainingCapacity(trimmed.len);
+    }
+    return try line.toOwnedSlice(alloc);
+}
