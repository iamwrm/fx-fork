+fn isOpenCodeProviderArg(arg: []const u8) bool {
+    return std.mem.eql(u8, arg, "opencode") or
+        std.mem.eql(u8, arg, "zen") or
+        std.mem.eql(u8, arg, "opencode-go") or
+        std.mem.eql(u8, arg, "go");
+}
+
+fn runOpenCodeLogin(
+    alloc: Allocator,
+    deps: RunDeps,
+    provider_arg: []const u8,
+    key_arg: ?[]const u8,
+) !RunResult {
+    const go_fleet = std.mem.eql(u8, provider_arg, "opencode-go") or
+        std.mem.eql(u8, provider_arg, "go");
+    const label = if (go_fleet) "fx login opencode-go" else "fx login opencode";
+
+    const api_key: []u8 = if (key_arg) |value|
+        try alloc.dupe(u8, value)
+    else blk: {
+        try writeStdout(deps, "OpenCode API key: ");
+        break :blk opencode_auth.readApiKeyFromStdin(alloc) catch |err| switch (err) {
+            error.OutOfMemory => return err,
+            else => {
+                try writeLabeledStderr(alloc, deps, label, "could not read the API key from stdin");
+                return .handled_failure;
+            },
+        } orelse {
+            try writeLabeledStderr(alloc, deps, label, "no API key provided");
+            return .handled_failure;
+        };
+    };
+    defer secret.zeroAndFree(alloc, api_key);
+
+    opencode_auth.saveApiKey(alloc, api_key) catch {
+        try writeLabeledStderr(alloc, deps, label, "failed to save the API key");
+        return .handled_failure;
+    };
+
+    var attempt = config_runtime.attemptUserPreferences(alloc, .{
+        .credential_source = .opencode,
+        .model = if (go_fleet)
+            opencode_auth.go_model_prefix ++ "kimi-k2.7-code"
+        else
+            opencode_auth.model_prefix ++ "kimi-k2.7-code",
+    });
+    defer attempt.deinit(alloc);
+    switch (attempt) {
+        .outcome => {},
+        .failure => try writeLabeledStderr(
+            alloc,
+            deps,
+            label,
+            "signed in, but could not save the default credential and model",
+        ),
+    }
+    try writeStdout(deps, "Signed in to OpenCode.\n");
+    return .handled_success;
+}
+
+fn writeLabeledStderr(
+    alloc: Allocator,
+    deps: RunDeps,
+    label: []const u8,
+    message: []const u8,
+) !void {
+    const text = try std.fmt.allocPrint(alloc, "{s}: {s}\n", .{ label, message });
+    defer alloc.free(text);
+    try writeStderr(deps, text);
+}
+
 fn writeStdout(deps: RunDeps, text: []const u8) !void {
     try deps.write_stdout(deps.stdout_ctx, text);
 }
