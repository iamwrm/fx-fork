+// Static provider-scoped catalog. OpenCode does not expose a public model
+// listing yet, so the menu offers the documented fleet models; `/model` still
+// accepts any `opencode/<id>` or `opencode-go/<id>` typed manually.
+const static_catalog_ids = [_][]const u8{
+    "opencode/kimi-k3",
+    "opencode/kimi-k2.7-code",
+    "opencode-go/mimo-v2.5",
+    "opencode-go/kimi-k2.7-code",
+};
+
+fn fetchStaticCatalog(
+    _: ?*anyopaque,
+    alloc: Allocator,
+    input: model_catalog.FetchInput,
+) Allocator.Error!model_catalog.ProviderResult {
+    _ = input;
+    var catalog: std.ArrayList(model_catalog.ModelCatalogEntry) = .empty;
+    errdefer {
+        for (catalog.items) |*entry| {
+            alloc.free(entry.id);
+            alloc.free(entry.model_type);
+        }
+        catalog.deinit(alloc);
+    }
+    for (static_catalog_ids) |id| {
+        try catalog.append(alloc, .{
+            .id = try alloc.dupe(u8, id),
+            .model_type = try alloc.dupe(u8, "language"),
+            .has_tool_use = true,
+        });
+    }
+    return .{ .catalog = catalog };
+}
+
+pub const model_catalog_provider = model_catalog.Provider{
+    .fetch_fn = fetchStaticCatalog,
+};
+
+const gateway_provider = @import("../core/gateway/gateway_provider.zig");
+
+fn fetchCliStaticCatalog(
+    _: ?*anyopaque,
+    alloc: Allocator,
+    input: gateway_provider.CliModelCatalogInput,
+) gateway_provider.CliModelCatalogResult {
+    return switch (model_catalog.fetchWithPublicFallback(model_catalog_provider, alloc, .{
+        .access = input.access,
+        .endpoint = input.endpoint,
+        .cancel_flag = input.cancel_flag,
+        .view = .full,
+    })) {
+        .loaded => |loaded| blk: {
+            var catalog = loaded.catalog;
+            defer model_catalog.freeModelCatalog(alloc, &catalog);
+            const ids = model_catalog.projectModelIds(alloc, catalog.items) catch return .{ .failure = .{
+                .access = loaded.provenance.access,
+                .anonymous_fallback_used = false,
+                .failure = .{ .category = .resource_exhausted },
+            } };
+            break :blk .{ .loaded = .{
+                .ids = ids,
+                .provenance = loaded.provenance,
+            } };
+        },
+        .failed => |failure| .{ .failure = failure },
+    };
+}
+
+pub const cli_model_catalog_provider = gateway_provider.CliModelCatalogProvider{
+    .fetch_fn = fetchCliStaticCatalog,
+};
